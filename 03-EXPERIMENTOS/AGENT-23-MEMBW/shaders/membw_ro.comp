#version 450
// READ-ONLY stream: 4 B loaded per element, nothing written per element.
//
// WHY THIS EXISTS
//   The read+write kernel saturates at 41.2 GB/s against a ~96 GB/s mclk
//   ceiling.  A read/write mix on GDDR5 costs bus turnaround cycles, so a mixed
//   stream is NOT expected to reach the single-direction peak.  Without a
//   read-only measurement the 41.2 GB/s cannot be attributed: it is either the
//   memory system's ceiling for mixed traffic, or a turnaround penalty on top of
//   a much higher one-directional peak.  These separate exactly.
//
// ORACLE
//   A read-only kernel is at risk of being optimised away, so each thread
//   reduces its 4 loaded scalars and writes ONE accumulator to dst[base+id].
//   dst is therefore written (the load is live and cannot be eliminated) but the
//   written volume is 1/4 of the loaded volume.  The host predicts every
//   accumulator independently, so a skipped load fails the check.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Src4 { uint data[]; } src;
layout(set = 0, binding = 1) buffer Dst4 { uint data[]; } dst;

layout(push_constant) uniform PC {
  uint n;      // elements consumed by this chunk
  uint iters;  // ALU iterations per element
  uint seed;   // xor mask, part of the oracle
  uint base;   // element offset of this chunk
} pc;

void main() {
  uint id = gl_GlobalInvocationID.x;
  if (id >= pc.n) return;

  uint acc = 0u;
  for (uint k = 0u; k < 4u; k++) {
    uint idx = pc.base + id * 4u + k;
    if (idx < pc.base + pc.n) {
      uint v = src.data[idx];
      for (uint j = 0u; j < pc.iters; j++) v = (v ^ (v << 13)) * 0x5bd1e995u;
      acc += v;
    }
  }
  dst.data[pc.base + id] = acc ^ pc.seed;
}