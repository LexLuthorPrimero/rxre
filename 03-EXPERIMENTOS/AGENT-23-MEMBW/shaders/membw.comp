#version 450
// STREAM-like kernel for AGENT-23 MEMBW.
// Traffic per element: one 4-byte load + one 4-byte store (8 B) when iters==0.
// iters adds a dependent ALU chain -> arithmetic-intensity knob to separate
// MEMORY-BOUND from COMPUTE-BOUND.  The oracle is dst[i] = f(src[i]) with f
// fully known to the host, so the host can verify real data movement instead of
// trusting exit status.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Src { uint data[]; } src;
layout(set = 0, binding = 1) writeonly buffer Dst { uint data[]; } dst;

layout(push_constant) uniform PC {
  uint n;      // elements in this chunk
  uint iters;  // ALU iterations per element
  uint seed;   // xor mask, part of the oracle
  uint base;   // element offset of this chunk (dispatch x is capped at 65535)
} pc;

void main() {
  uint i = pc.base + gl_GlobalInvocationID.x;
  if (i >= pc.base + pc.n) return;

  uint v = src.data[i];
  for (uint k = 0u; k < pc.iters; k++) {
    // dependent chain: latency-bound, so it adds work without adding traffic
    v = (v ^ (v << 13)) * 0x5bd1e995u;
  }
  dst.data[i] = v ^ pc.seed;
}