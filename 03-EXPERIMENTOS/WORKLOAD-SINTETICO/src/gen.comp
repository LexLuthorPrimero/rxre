#version 450
// Genera el contenido determinista de las texturas de 4096^2 RGBA8 (un dispatche por imagen).
// Patrón de ruido con la misma familia de hash que el fragment shader.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outTex[4];

layout(push_constant) uniform PC {
    uint base; // índice de imagen a generar (0..3)
} pc;

uint hashp(uvec2 p, uint salt) {
    uint h = p.x * 0x9E3779B1u ^ p.y * 0x85EBCA77u ^ salt;
    h ^= h >> 16;
    h *= 0x7FEB352Du;
    h ^= h >> 15;
    h *= 0x846CA68Bu;
    h ^= h >> 16;
    return h;
}

void main() {
    uvec2 c = gl_GlobalInvocationID.xy;
    uint  h = hashp(c, 0x15AB1u ^ pc.base);
    vec4  v = vec4(float(h & 255u), float((h >> 8) & 255u),
                   float((h >> 16) & 255u), float((h >> 24) & 255u)) / 255.0;
    imageStore(outTex[pc.base], ivec2(c), v);
}