#version 450
// DISCRIMINANTE de 282-1. La cadena dependiente de occ.comp/chain.comp cuesta ~1,35 ns por
// acceso (7,0 ciclos). Se？现在 cuatro hipótesis y esta nota separa dos de ellas:
//
//   H1  el coste es la LECTURA de memoria y no se esta costing
//   H2  el coste es la DIVISION ENTERNA (idx = acc % WSIZE), que en GFX8 no existe en
//       hardware y se emula con una secuencia de multiplicaciones y restas
//
// Si H2 es correcta, sustituir el modulo por una mascara (WSIZE potencia de dos) tiene que
// reducir el tiempo. Si el tiempo no cambia, H2 queda descartada y queda H1.
//
// MODE en constant_id=2:
//   0  idx = acc % WSIZE        division
//   1  idx = acc & (WSIZE - 1)  mascara; exige WSIZE potencia de dos
// En los dos modos la cadena sigue siendo dependiente: idx depende de acc, acc depende de
// la lectura. Lo único que cambia es la operación que produce el índice siguiente.
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITERS  = 1u;
layout(constant_id = 1) const uint WSIZE  = 1024u;
layout(constant_id = 2) const uint MODE   = 0u;
layout(constant_id = 3) const uint STEPS  = 0u;
layout(std430, binding = 0) buffer B { uint d[]; };
uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint idx = hash(i + 0x9e3779b9u) % WSIZE;
    uint acc = 0u;
    for (uint k = 0u; k < ITERS; k++) {
        uint v = d[idx];
        acc = acc * 1664525u + v + 1013904223u;
        idx  = (MODE == 0u) ? (acc % WSIZE)
                            : (acc & (WSIZE - 1u));
        for (uint s = 0u; s < STEPS; s++) idx = hash(idx) % WSIZE;
        acc = acc + idx;
    }
    d[WSIZE + i] = acc;
}
