#version 450
// KERNEL DE CONTROL. Sin trafico de memoria en el bucle: mide el techo de ALU y sirve de
// referencia al modelo del host. La escritura va a d[WSIZE + i], la region disjunta de la
// de lectura, igual que occ.comp y chain.comp (283). Antes escribia en d[i] y con el
// banco de dos regiones el control falla: lo detecto el propio readback.
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITERS = 1u;
layout(constant_id = 1) const uint WSIZE = 1024u;   /* tamano de la region de lectura */
layout(std430, binding = 0) buffer B { uint d[]; };
void main() {
      uint i = gl_GlobalInvocationID.x;
      uint a = d[i] + i;
      for (uint k = 0u; k < ITERS; k++)
          a = a * 1664525u + 1013904223u;
      a ^= (a >> 13);
      d[WSIZE + i] = a;
}
