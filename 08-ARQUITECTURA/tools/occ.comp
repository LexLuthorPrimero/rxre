#version 450
// KERNEL DE OCUPACION BAJA — las tres condiciones que 267 identifico como necesarias.
//
// 1. POCOS HILOS. El working set se pasa aparte (constant_id=1 = WSIZE) y el dispatch lo fija
//    el host. Con items=256 hay 4 workgroups: la maquina esta mayormente vacia, asi que
//    ningun otro warp puede tapar la latencia de este.
// 2. ACCESOS ALEATORIOS. El indice siguiente sale de un hash del valor LEIDO, no del
//    contador del bucle. Un prefetch no puede anticipar un indice que depende del dato.
// 3. CADENA DEPENDIENTE. idx depende de d[idx] anterior: cada acceso espera al anterior.
//    El hardware no puede reordenar ni solapar accesos de la misma cadena.
//
// Con las tres, el tiempo por acceso es la LATENCIA de memoria, no la tasa de emision.
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITERS  = 1u;
layout(constant_id = 1) const uint WSIZE  = 1024u;   /* dwords del conjunto de trabajo */
layout(std430, binding = 0) buffer B { uint d[]; };

/* Hash entero de Owen-ish: mezcla todos los bits, sin multiplicacion que dependa del
 * ancho de palabra. Mismo objetivo que el hash del host, para que el control pueda
 * replicarlo: si divergen, el readback lo detecta. */
uint hash(uint x)
{
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint acc = 0u;

    /* Semilla distinta por hilo: si todos empiezan en el mismo indice, los 4 workgroups
     * pegarian al mismo CU al principio y la medicion seria de 1 CU, no de la GPU. */
    uint idx = hash(i + 0x9e3779b9u) % WSIZE;

    for (uint k = 0u; k < ITERS; k++) {
        uint v   = d[idx];              /* la lectura: aqui se paga la latencia */
        acc      = acc * 1664525u + v + 1013904223u;   /* consume v: impide reordenar */
        /* el indice siguiente depende de v Y de acc: cadena, y ademas aleatorio */
        idx      = hash(acc ^ (k * 0x85ebca6bu)) % WSIZE;
    }

    /* Se escribe en d[WSIZE + i], NO en d[i]. La region de escritura [WSIZE, WSIZE+items)
     * es disjunta de la de lectura [0, WSIZE), asi que ningun hilo puede leer lo que otro
     * escribio. Antes se escribia en d[i] y con idx cayendo en [0,items) el hilo leia una
     * palabra que otro ya habia escrito: el control fallaba 0 de 40 con ITERS=64
     * (medido en 282). La posicion sigue siendo predecible palabra a palabra. */
    d[WSIZE + i] = acc;
}
