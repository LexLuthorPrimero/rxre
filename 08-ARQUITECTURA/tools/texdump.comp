#version 450
// CONTROL DE LA RUTA DE TEXEL. No mide nada: comprueba que una VkImage creada y
// rellenada por el banco devuelve, con texelFetch, los MISMOS bytes que el storage
// buffer, y que el indice i del shader llega al texel i.
//
// Sin este control, un banco que mide la ruta de texel no distingue "la ruta de texel
// es mas lenta" de "la imagen no tiene lo que deberia". Las dos dan una diferencia de
// tiempo y ninguna de las dos es el hallazgo.
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITERS = 1u;
layout(constant_id = 1) const uint WSIZE = 1024u;
layout(constant_id = 2) const uint STEPS = 1u;
layout(std430, binding = 0) buffer B { uint d[]; };
layout(binding = 1) uniform usampler2D tex;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= WSIZE) return;
    d[WSIZE + i] = texelFetch(tex, ivec2(int(i), 0), 0).x;
}
