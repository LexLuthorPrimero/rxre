#version 450
// KERNEL NULO: no hace trafico de memoria en el bucle. Mide el coste FIJO del despacho
// mas la copia del patron que el banco mete DENTRO de la region cronometrada.
// Si t(items) crece con items, esa pendiente es contaminacion de toda medicion.
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITERS = 1u;
layout(constant_id = 1) const uint STRIDE = 16u;
layout(std430, binding = 0) buffer B { uint d[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint a = 0u;
    for (uint k = 0u; k < ITERS; k++) a += k * 2654435761u;
    d[i] = a;                       /* una sola escritura: 4 B por hilo */
}
