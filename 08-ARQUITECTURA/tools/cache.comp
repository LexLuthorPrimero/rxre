#version 450
// KERNEL CACHE: mide el tamano de la cache por el punto de meseta del ancho de banda.
// Reads con salto fijo sobre un conjunto de trabajo de tamano W (= items, el buffer).
// Mientras W quepa en la cache, el salto se resuelve en ella y el ancho de banda es alto.
// Cuando W no cabe, cada acceso va a VRAM y el ancho cae al del reloj de memoria.
// El codo de esa curva ES el tamano de la cache. No se lee de ningun sitio: se mide.
//
// El salto por defecto es 16 dwords = 64 B = una linea de cache: asi cada acceso
// entra en una linea distinta y no hay reutilizacion dentro de la misma linea.
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITERS  = 1u;
layout(constant_id = 1) const uint STRIDE = 16u;
layout(std430, binding = 0) buffer B { uint d[]; };
void main() {
    uint i    = gl_GlobalInvocationID.x;
    uint total= gl_NumWorkGroups.x * gl_WorkGroupSize.x;   /* == items */
    uint a = 0u;
    for (uint k = 0u; k < ITERS; k++) {
        uint idx = (i + k * STRIDE) % total;
        a += d[idx];
        a ^= (a >> 7);
    }
    d[i] = a;
}
