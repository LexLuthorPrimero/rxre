#version 450
// KERNEL MEM: mide el ancho de la VRAM, no la ALU.
// Lee y escribe un bucle sobre el buffer con DESPLAZAMIENTO, de modo que cada acceso
// cae en una linea distinta y no se sirve de la cache. Sin transferencia entre shaders,
// no hay dependencia, asi que solo queda el ancho de banda de la memoria.
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITERS = 1u;
layout(constant_id = 1) const uint NACC  = 8u;
layout(std430, binding = 0) buffer B { uint d[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint stride = (gl_NumWorkGroups.x * gl_WorkGroupSize.x);
    uint a0=0u,a1=0u,a2=0u,a3=0u,a4=0u,a5=0u,a6=0u,a7=0u;
    for (uint k = 0u; k < ITERS; k++) {
        uint p = i + k * stride;
        a0 += d[p];
        a1 += d[p + 1u];
        a2 += d[p + 3u];
        a3 += d[p + 7u];
        a4 += d[p + 15u];
        a5 += d[p + 31u];
        a6 += d[p + 63u];
        a7 += d[p + 127u];
    }
    d[i] = a0 ^ a1 ^ a2 ^ a3 ^ a4 ^ a5 ^ a6 ^ a7;
}
