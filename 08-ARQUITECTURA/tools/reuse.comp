#version 450
// LA VIA QUE 288 DICE QUE SI FUNCIONA para medir el tamano de una cache.
//
// El problema del barrido aleatorio de 288: cada hilo recorre direcciones nuevas, sin
// reutilizacion, y entonces la tasa de acierto no depende del tamano del conjunto sino del
// solape entre las direcciones vivas y la capacidad. El punto de meseta mide una transicion
// de estructura, no un tamano.
//
// Aqui la distancia de reutilizacion es una VARIABLE. Cada hilo tiene un bloque de B
// direcciones y elige dentro de el pseudoaleatoriamente, de modo que:
//
//   distancia de reutilizacion = B palabras del hilo
//   huella total               = items x B
//
// Al crecer B, la distancia crece, y el acceso deja de acertar en L1 y luego en L2. Los dos
// codos de la curva son las capacidades. Y la cadena sigue siendo dependiente —el indice
// sale de acc, acc sale de la lectura— porque si no, el hardware prefetcharia el bloque
// entero y la latencia quedaria oculta.
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITERS = 1u;   /* vueltas por hilo */
layout(constant_id = 1) const uint WSIZE = 1024u; /* dwords totales = items x B */
layout(constant_id = 2) const uint B     = 16u;   /* direcciones por hilo */
layout(std430, binding = 0) buffer BUF { uint d[]; };
void main() {
    uint i   = gl_GlobalInvocationID.x;
    uint blk = i * B;                 /* bloque propio del hilo, sin solape */
    uint acc = 0u;
    for (uint k = 0u; k < ITERS; k++) {
        uint idx = blk + ((acc ^ k) % B);   /* dentro del bloque, y depende de acc */
        uint v   = d[idx];
        acc = acc * 1664525u + v + 1013904223u;
    }
    d[WSIZE + i] = acc;
}
