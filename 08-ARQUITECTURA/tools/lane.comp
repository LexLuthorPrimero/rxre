#version 450
// DISCRIMINANTE de 287-1 (reformulado por segunda vez). A huella de 256 MiB el ancho de banda
// util medido con div.comp es 1,53-1,85 GB/s, del 32-38% del techo que permitiria mclk 300 MHz.
// Pero ese numero ya no es una medicion de DRAM: ver la nota del colapso de abajo.
//
// LANEMODE selecciona el reparto de DIRECCIONES, con el mismo numero de cargas de carril, el
// mismo numero de iteraciones y la misma cantidad de trabajo de ALU en los dos casos:
//
//   LANEMODE=1  DISPERSO : cada carril con su propia direccion.
//                          Bytes utiles por transaccion = 4.
//   LANEMODE=0  DIFUSION : los 64 carriles del wavefront leen la MISMA direccion.
//                          UNA transaccion para 64 carriles. Bytes utiles = 256.
//   LANEMODE=2  CONTIGUO : los 64 carriles leen direcciones CONSECUTIVAS, 64 dwords = 256 B.
//                          Es lo que hace un driver bien escrito, y el peldano intermedio
//                          entre los otros dos: si la granularidad fuera la causa, este modo
//                          deberia caer por debajo de la difusion y por encima de la dispersion.
//                          Avanza 64*4096 dwords por vuelta para que las vueltas successive
//                          no reutilicen las mismas lineas.
//
// ADDR=1 hace que el shader escriba la ULTIMA direccion leida en vez de la cadena, para que el
// patron de direcciones sea un observable DIRECTO y no una inferencia.
//
// EL COLAPSO DE LA CADENA, y por que este kernel mezcla por iteracion:
//
//   El estado del sistema solo es idx, porque idx = acc mod WSIZE. Sustituyendo en la
//   recurrencia, idx_{k+1} = (1664525 mod WSIZE + 1) * idx_k + C (mod WSIZE), que es una
//   recurrencia LINEAL. Con WSIZE = 4096 el factor es 862 y gcd(862, 4096) = 2, luego la imagen
//   tiene como maximo 2048 elementos y cada iteracion la reduce mas. Medido por programa: con
//   4096 hilos de partida, el numero de indices distintos cae a 186 con 4 iteraciones, a UN
//   SOLO valor con 16, y se queda ahi. La cadena no es un paseo aleatorio: colapsa.
//
//   Dos consecuencias, y las dos importan:
//     1. Un modo «disperso» escrito con idx = acc % WSIZE NO es disperso. Se wydetecta mirando
//        las direcciones que el shader写的, no el resultado, porque el modelo del host hace la
//        misma cuenta y por tanto el control de contenido pasa igual.
//     2. div.comp, con el que se midieron 1,53-1,85 GB/s, colapsa tambien: 19 indices
//        distintos de 4096 con 1024 iteraciones. Ese numero es de 19 direcciones, no de DRAM.
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITERS    = 1u;
layout(constant_id = 1) const uint WSIZE    = 1024u;
layout(constant_id = 2) const uint LANEMODE = 1u;   /* 0 = difusion, 1 = disperso */
layout(constant_id = 3) const uint ADDR     = 0u;   /* 1 = escribe direccion Y cadena */
/* STRIDE: cuantos dwords avanza el reparto CONTIGUO por vuelta. Con 262144 avanza 1 MiB y
 * el periodo del patron es WSIZE/STRIDE. Con 65536 avanza 256 KiB y el periodo es WSIZE/65536.
 * Sirve para separar RESERVADO de SEPARADO: el biffer puede seguir siendo de 64 MiB mientras
 * las direcciones se confinan a 16 MiB, y el patron de reutilizacion pasa a ser el de 16 MiB
 * con una reserva de 64. Si el transitorio depende de la reserva aparece igual; si depende de
 * la separacion, desaparece. */
layout(constant_id = 4) const uint STRIDE = 262144u;
/* SUBRANGE: los indices se reducen primero modulo SUBRANGE y solo despues modulo WSIZE. Con
 * SUBRANGE < WSIZE el patron recorre una subregion del biffer y deja el resto sin tocar, con lo
 * que se separa el TAMANO RESERVADO del SEPARADO: mismo biffer, mismo numero de cargas y misma
 * reserva, y solo cambia hasta donde se esparcen las direcciones. Con SUBRANGE = 0 el
 * comportamiento es identico al que habia antes de anadir esta constante. */
layout(constant_id = 5) const uint SUBRANGE = 0u;   /* 0 = igual que WSIZE */
/* items es el tamano del despacho; hace falta para separar las dos regiones de escritura.
 * Se toma de gl_WorkGroupSize.x y del tamano del grupo: el banco lanza ceil(items/64)
 * grupos de 64, luego items = 64 * grupos. */
layout(std430, binding = 0) buffer BUF { uint d[]; };
uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}
void main() {
    uint i    = gl_GlobalInvocationID.x;
    uint lane = gl_LocalInvocationID.x;
    uint base = i - lane;          /* indice global del hilo 0 de este wavefront */
    uint idx;
    if      (LANEMODE == 1u) idx = hash(i + 0x9e3779b9u) % WSIZE;
    else if (LANEMODE == 2u) idx = (base + lane + 0x9e3779b9u)
                                    % (SUBRANGE == 0u ? WSIZE : SUBRANGE);
    else                    idx = base % (SUBRANGE == 0u ? WSIZE : SUBRANGE);
    uint acc  = 0u;
    for (uint k = 0u; k < ITERS; k++) {
        if (LANEMODE == 0u) idx = (base + k * 2654435761u) % (SUBRANGE == 0u ? WSIZE : SUBRANGE);
        if (LANEMODE == 2u) idx = (base + lane + k * STRIDE)
                                      % (SUBRANGE == 0u ? WSIZE : SUBRANGE);
        uint v = d[idx];
        acc = acc * 1664525u + v + 1013904223u;
        if (LANEMODE == 1u) idx = hash(acc ^ (k * 0x85ebca6bu))
                                      % (SUBRANGE == 0u ? WSIZE : SUBRANGE);  /* ver EL COLAPSO */
    }
    /* CON ADDR=1 hay que escribir LAS DOS COSAS. Con una sola, acc queda muerto y el
     * compilador borra la cadena entera: en difusion y en contiguo idx no depende de ninguna
     * carga, luego se deduce en forma cerrada y las 1024 cargas que el experimento cuenta
     * desaparecen. El tiempo medido entonces era el de un bucle vacio multiplicado por
     * numero de iteraciones, y salia 280x mas rapido. Medido, no supuesto: con la version de
     * una sola palabra, ADDR=1 daria ~1e11 cargas/s en los modos 0 y 2, imposibles para DRAM.
     * Escribir acc en una segunda region la deja viva y con ella todas las cargas. */
    if (ADDR == 1u) {
        d[WSIZE + i]           = idx;   /* el banco lee aqui: la ultima direccion */
        d[WSIZE + (uint(gl_NumWorkGroups.x) * 64u) + i] = acc;   /* y aqui la cadena */
    } else {
        d[WSIZE + i] = acc;
    }
}
