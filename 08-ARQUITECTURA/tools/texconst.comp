#version 450
// SONDA. Escribe una constante en vez de leer la imagen. Si esto no llega al
// readback, el problema es el despacho o la escritura; si llega, el problema es el
// contenido de la imagen. Divide el espacio de hipotesis en dos sin suponer nada.
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITERS = 1u;
layout(constant_id = 1) const uint WSIZE = 1024u;
layout(constant_id = 2) const uint STEPS = 1u;
layout(std430, binding = 0) buffer B { uint d[]; };
layout(binding = 1) uniform usampler2D tex;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= WSIZE) return;
    d[WSIZE + i] = 0xABCDEF01u;
}
