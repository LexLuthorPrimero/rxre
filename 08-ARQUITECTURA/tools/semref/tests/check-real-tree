#!/bin/bash
# check-real-tree — contraste de semref contra un árbol real del kernel.
#
#   tests/check-real-tree [raiz-amdgpu]
#   SEMREF_SYMS="s1 s2"  sobreescribe los símbolos a comprobar
#
# Es OPT-IN a proposito: necesita un árbol del kernel, asi que no forma parte de
# la regresion hermetica de run-bench (que solo usa corpus congelados). Comprueba
# que el recuento de llamadas coincide con un control `grep` independiente, que
# es la unica forma de detectar que el motor pierde o inventa sitios.
#
# SEMÁNTICA DE LOS RESULTADOS — no confundir:
#
#   PASS        semref y grep coinciden. Incluye el caso en que AMBOS no
#               encuentran el símbolo: `SIN-MATCH` + `grep=0` es concordancia,
#               no ausencia de datos.
#   MISMATCH    discrepancia real y accionable. O los numeros difieren, o
#               semref dice SIN-MATCH mientras grep encuentra apariciones
#               (tipicamente un prototipo en un .c, que grep cuenta como
#               llamada y semref no).
#   ERROR       semref no devolvio ni TOTAL ni SIN-MATCH. No se compara: un fallo
#               de herramienta no es un resultado semantico.
#   NOT_AVAILABLE  el corpus no existe. rc=3. Nunca se convierte en MISMATCH.
#
# Salida: rc=0 si todo PASS, rc=1 si hay MISMATCH o ERROR, rc=3 si no se puede
# determinar el corpus o falta un motor.
set -uo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
SEMREF="$HERE/../semref"
ROOT="${1:-$(cd "$HERE/../../../.." && pwd)/RESEARCH/kernelbuild/linux-7.1.3/drivers/gpu/drm/amd/amdgpu}"
SYMS="${SEMREF_SYMS:-amdgpu_fence_process amdgpu_fence_schedule_fallback amdgpu_fence_driver_force_completion}"

# --- identidad del corpus ---------------------------------------------------
# Se deriva de un Makefile de kernel que declare VERSION/PATCHLEVEL/SUBLEVEL.
# NO se infiere del nombre del directorio: un arbol puede llamarse 7.2.8 y no
# llevar esa evidencia. Si no aparece, se declara NOT_DETERMINED.
corpus_version() {
  local d="$1" v p s
  while [ "$d" != "." ] && [ "$d" != "/" ] && [ -n "$d" ]; do
    if [ -f "$d/Makefile" ] && grep -qE '^VERSION[[:space:]]*=' "$d/Makefile" 2>/dev/null; then
      v=$(sed -n 's/^VERSION[[:space:]]*=[[:space:]]*\([0-9]\+\).*/\1/p' "$d/Makefile" | head -1)
      p=$(sed -n 's/^PATCHLEVEL[[:space:]]*=[[:space:]]*\([0-9]\+\).*/\1/p' "$d/Makefile" | head -1)
      s=$(sed -n 's/^SUBLEVEL[[:space:]]*=[[:space:]]*\([0-9]\+\).*/\1/p' "$d/Makefile" | head -1)
      if [ -n "$v" ] && [ -n "$p" ] && [ -n "$s" ]; then
        printf '%s.%s.%s\n' "$v" "$p" "$s"; return 0
      fi
    fi
    d=$(dirname "$d")
  done
  printf 'NOT_DETERMINED\n'
}

# --- guardas ----------------------------------------------------------------
"$SEMREF" engines >/dev/null 2>&1 || { echo "NOT_AVAILABLE: falta ctags o coccinelle (rc=3)"; exit 3; }
if [ ! -d "$ROOT" ]; then
  echo "NOT_AVAILABLE: raiz no existe: $ROOT (rc=3)"
  echo "  Esto NO es ausencia de callers: es ausencia del corpus. No se compara nada."
  exit 3
fi

VER=$(corpus_version "$ROOT")
echo "=== check-real-tree ==="
echo "raiz  : $ROOT"
echo "corpus: $VER   (derivado de un Makefile con VERSION/PATCHLEVEL/SUBLEVEL; no del nombre del directorio)"
echo

PASS=0; FAIL=0; ERR=0
for s in $SYMS; do
  out=$(timeout 900 "$SEMREF" refs "$s" --root "$ROOT" 2>/dev/null)

  # control independiente: ocurrencias textuales menos ficheros con definicion
  text=$(grep -rhoF "$s(" "$ROOT" --include='*.c' 2>/dev/null | wc -l)
  defs=$(grep -rlE "^[a-zA-Z_].*[ *]$s\(" "$ROOT" --include='*.c' 2>/dev/null | wc -l)
  grepcalls=$((text - defs))

  if printf '%s\n' "$out" | grep -q '^SIN-MATCH'; then
    semstate="SIN-MATCH"; semcalls=0
  elif printf '%s\n' "$out" | grep -q '^TOTAL'; then
    semstate="TOTAL"
    semcalls=$(printf '%s' "$out" | sed -n 's/.*llamadas=\([0-9]*\).*/\1/p')
    semdefs=$(printf '%s' "$out" | sed -n 's/.*definicion=\([0-9]*\).*/\1/p')
  else
    semstate="SIN-SALIDA"; semcalls=""; semdefs=""
  fi

  case "$semstate" in
    SIN-SALIDA)
      printf '  %-42s semref=%-12s grep=%-5s ERROR\n' "$s" "$semstate" "$grepcalls"
      ERR=$((ERR+1)); FAIL=$((FAIL+1)) ;;
    SIN-MATCH)
      if [ "$grepcalls" -eq 0 ]; then
        printf '  %-42s semref=%-12s grep=%-5s PASS (ambos no lo encuentran)\n' "$s" "$semstate" "$grepcalls"
        PASS=$((PASS+1))
      else
        printf '  %-42s semref=%-12s grep=%-5s MISMATCH (semref no lo ve, grep=%s: revisable)\n' \
               "$s" "$semstate" "$grepcalls" "$text"
        FAIL=$((FAIL+1))
      fi ;;
    TOTAL)
      if [ "$semcalls" = "$grepcalls" ] && [ "$semdefs" = "$defs" ]; then
        printf '  %-42s semref=%-12s grep=%-5s PASS (def %s/%s)\n' "$s" "$semcalls" "$grepcalls" "$semdefs" "$defs"
        PASS=$((PASS+1))
      else
        printf '  %-42s semref=%-12s grep=%-5s MISMATCH (def %s/%s)\n' "$s" "$semcalls" "$grepcalls" "$semdefs" "$defs"
        FAIL=$((FAIL+1))
      fi ;;
  esac
done

echo
echo "RESULTADO: PASS=$PASS FAIL=$FAIL (ERROR=$ERR)  corpus=$VER"
[ "$FAIL" -gt 0 ] && exit 1
exit 0
