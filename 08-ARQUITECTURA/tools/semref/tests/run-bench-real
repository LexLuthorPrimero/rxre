#!/bin/bash
# run-bench-real — regresión de check-real-tree.
#
#   tests/run-bench-real
#
# Existe SEPARADO de run-bench a propósito: run-bench es la suite hermética de
# corpus congelados y no debe cambiar de semántica; check-real-tree es opt-in
# porque necesita un árbol. Este script prueba la LÓGICA de check-real-tree
# contra árboles sintéticos, así que sigue siendo hermético sin mezclarlos.
#
# Cubre los dos defectos corregidos:
#   D-1  SIN-MATCH + grep=0 es CONCORDANCIA, no discrepancia.
#        Y SIN-MATCH + grep>0 sí es discrepancia real.
#   D-2  la identidad del corpus sale de un Makefile con VERSION/PATCHLEVEL/
#        SUBLEVEL, nunca del nombre del directorio; si no hay, NOT_DETERMINED.
set -uo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
CRT="$HERE/check-real-tree"
W=$(mktemp -d /tmp/opencode/realbench.XXXXXX)
trap 'rm -rf "$W"' EXIT

PASS=0; FAIL=0; FAILED=()
check() { # <etiqueta> <esperado> <obtenido>
  if [ "$2" = "$3" ]; then
    printf '  PASS  %-44s %s\n' "$1" "$2"; PASS=$((PASS+1))
  else
    printf '  FAIL  %-44s\n        esperado: %s\n        obtenido: %s\n' "$1" "$2" "$3"
    FAIL=$((FAIL+1)); FAILED+=("$1")
  fi
}

# --- árboles sintéticos ----------------------------------------------------
# T-abs: símbolo totalmente ausente
mkdir -p "$W/abs"
cat > "$W/abs/a.c" <<'EOF'
int presente(int x) { return x; }
EOF

# T-cmt: la llamada está en un COMENTARIO. grep no distingue comentarios;
# semref sí. Produce SIN-MATCH con grep>0, o sea discrepancia real y accionable.
mkdir -p "$W/cmt"
cat > "$W/cmt/a.c" <<'EOF'
/* solo_en_comentario(ring); */
int otra_cosa(int x) { return x; }
EOF

# T-ver: kernel con Makefile -> versión verificable
mkdir -p "$W/ver/amdgpu"
printf 'VERSION = 9\nPATCHLEVEL = 9\nSUBLEVEL = 9\nEXTRAVERSION =\n' > "$W/ver/Makefile"
cat > "$W/ver/amdgpu/a.c" <<'EOF'
int presente(int x) { return x; }
int lo_invoca(int x) { return presente(x); }
EOF

# T-nover: sin Makefile de kernel en ninguna ascendencia -> NOT_DETERMINED
mkdir -p "$W/nover/drivers/gpu/drm/amd/amdgpu"
cp "$W/ver/amdgpu/a.c" "$W/nover/drivers/gpu/drm/amd/amdgpu/a.c"

echo "=== run-bench-real  regresión de check-real-tree ==="

echo
echo "TEST A  símbolo ausente: semref=SIN-MATCH, grep=0  ->  PASS (concordancia)"
out=$(SEMREF_SYMS="no_existe_zzz" "$CRT" "$W/abs" 2>&1); rc=$?
check "A veredicto PASS" "1" "$(printf '%s\n' "$out" | grep -c 'PASS (ambos no lo encuentran)')"
check "A sin MISMATCH"         "0"    "$(printf '%s\n' "$out" | grep -c 'MISMATCH')"
check "A rc"                   "0"    "$rc"

echo
echo "TEST B  símbolo presente y coincidente: semref=N, grep=N  ->  PASS"
out=$(SEMREF_SYMS="presente" "$CRT" "$W/ver/amdgpu" 2>&1); rc=$?
check "B veredicto semref=1 grep=1" "1" "$(printf '%s\n' "$out" | grep -cE 'presente +semref=1 +grep=1 +PASS')"
check "B rc"         "0"    "$rc"

echo
echo "TEST C  discrepancia real: llamada en comentario, grep=1 semref=SIN-MATCH  ->  MISMATCH"
out=$(SEMREF_SYMS="solo_en_comentario" "$CRT" "$W/cmt" 2>&1); rc=$?
check "C veredicto MISMATCH" "1" "$(printf '%s\n' "$out" | grep -c 'MISMATCH')"
check "C rc"                 "1" "$rc"

echo
echo "TEST D  raiz ausente  ->  NOT_AVAILABLE, nunca MISMATCH"
out=$("$CRT" "$W/no-existe" 2>&1); rc=$?
check "D declara NOT_AVAILABLE" "1" "$(printf '%s\n' "$out" | grep -c 'NOT_AVAILABLE')"
check "D sin MISMATCH"          "0" "$(printf '%s\n' "$out" | grep -c 'MISMATCH')"
check "D rc"                    "3" "$rc"

echo
echo "TEST E  identidad del corpus"
out=$(SEMREF_SYMS="presente" "$CRT" "$W/ver/amdgpu" 2>&1)
check "E version con Makefile"      "corpus: 9.9.9" "$(printf '%s\n' "$out" | grep '^corpus:' | awk '{print $1" "$2}')"
out=$(SEMREF_SYMS="presente" "$CRT" "$W/nover/drivers/gpu/drm/amd/amdgpu" 2>&1)
check "E version sin Makefile"      "corpus: NOT_DETERMINED" "$(printf '%s\n' "$out" | grep '^corpus:' | awk '{print $1" "$2}')"
echo "  (el nombre del directorio no se usa: 'nover' no se convierte en version)"

echo
echo "RESULTADO: PASS=$PASS FAIL=$FAIL"
if [ "$FAIL" -gt 0 ]; then printf 'fallos: %s\n' "${FAILED[*]}"; exit 1; fi
exit 0
