#!/bin/bash
# semref — resolvedor de referencias de símbolo sobre código C del kernel.
#
#   semref refs  <símbolo> [--root DIR]        definiciones + call sites, clasificados
#   semref chain <símbolo> [--root DIR] --depth N   cierre transitivo de callers
#   semref engines                               estado de los motores
#
# Dos motores independientes:
#   ctags      -> DEFINICIONES (léxico, recorre el árbol entero)
#   Coccinelle -> CALL SITES (semántico; distingue llamada de definición, cosa que
#                 `grep` no puede hacer porque cuenta ambos con el mismo número)
#
# Garantías:
#   - NUNCA escribe dentro del árbol: Coccinelle se invoca sin --in-place.
#   - Salida determinista y ordenada.
#   - Control negativo explícito: símbolo inexistente -> SIN-MATCH.
#   - Si un motor falta, exits 3 con ENGINE-NOT-AVAILABLE. Nunca degrada en
#     silencio ni devuelve un PASS falso.
#
# Variables de entorno:
#   SEMREF_HOME   prefijo donde vive la instalación local de Coccinelle
#                 (por defecto /tmp/opencode/tools — efímero, ver README.md)
set -uo pipefail

SEMREF_HOME="${SEMREF_HOME:-/tmp/opencode/tools}"
SPATCH="${SEMREF_SPATCH:-$SEMREF_HOME/usr/lib64/coccinelle/spatch}"
CTAGS_BIN="${SEMREF_CTAGS:-$(command -v ctags 2>/dev/null)}"

# --- detección de motores: verificar el objeto, no un pariente -------------
engine_state() {
  local missing=0
  if [ -n "${CTAGS_BIN:-}" ] && [ -x "$CTAGS_BIN" ]; then
    echo "ctags       DISPONIBLE  $CTAGS_BIN  ($("$CTAGS_BIN" --version 2>/dev/null | head -1))"
  else
    echo "ctags       ENGINE-NOT-AVAILABLE"; missing=1
  fi
  if [ -x "$SPATCH" ] && LD_LIBRARY_PATH="$SEMREF_HOME/usr/lib64" COCCINELLE="$SEMREF_HOME/usr/lib64/coccinelle" \
        "$SPATCH" --version >/dev/null 2>&1; then
    local v
    v=$(LD_LIBRARY_PATH="$SEMREF_HOME/usr/lib64" COCCINELLE="$SEMREF_HOME/usr/lib64/coccinelle" \
        "$SPATCH" --version 2>/dev/null | grep -o 'spatch version [0-9.]*' | head -1)
    echo "coccinelle  DISPONIBLE  $SPATCH  (${v:-version no extraída})"
  else
    echo "coccinelle  ENGINE-NOT-AVAILABLE  ($SPATCH no ejecutable o libpcre ausente)"; missing=1
  fi
  return $missing
}

WORK=$(mktemp -d /tmp/opencode/semref.XXXXXX)
trap 'rm -rf "$WORK"' EXIT

# --- índice de definiciones (ctags): nombre TAB línea TAB fichero -----------
build_index() {
  local root="$1"
  ( cd "$root" && "$CTAGS_BIN" -R -x --kinds-c=f . 2>/dev/null ) \
    | awk '$2=="function" { print $1"\t"$3"\t"$4 }' \
    | LC_ALL=C sort -t"$(printf '\t')" -k1,1 -k2,2n > "$WORK/index.tsv"
}

# --- función envolvente -----------------------------------------------------
# El C no anida funciones -> la envolvente es la de mayor línea <= L.
# El índice está ordenado por NOMBRE, así que hay que maximizar la línea;
# quedarse con "la última encontrada" devuelve la mayor alfabéticamente.
# (regresión R-1 del benchmark)
enclosing() {
  awk -F'\t' -v L="$2" -v f="$1" '
    $3==f && $2+0 <= L { if ($2+0 > bl) { bl=$2+0; best=$1 } }
    END { print (best=="" ? "<fuera-de-funcion>" : best) }
  ' "$WORK/index.tsv"
}

# --- unified diff de Coccinelle -> file:línea del FICHERO ORIGINAL -----------
parse_calls() {
  awk -v sym="$1" '
    /^diff /   { f=""; next }
    /^--- a\// { f=substr($0,7); next }
    /^--- /    { next }
    /^\+\+\+ /  { next }
    /^@@/      { split($2,a,","); n=substr(a[1],2)+0; next }
    /^-/       {
      # R-3: una linea eliminada solo es sitio de llamada si contiene de
      # verdad la llamada esperada. En un if/else Coccinelle reemplaza la
      # rama completa, y lineas de contexto como "else" o "x = false;"
      # aparecen tambien como "-" sin ser llamadas.
      line = substr($0, 2)
      if (f != "" && line ~ sym "[ \t]*\\(") printf "%s\t%d\n", f, n
      n++; next
    }
    /^ /       { n++; next }
    /^\+/       { next }
  '
}

call_sites() {
  local sym="$1" root="$2"
  cat > "$WORK/call.cocci" <<EOF
@@
identifier f =~ "^${sym}\$";
expression list A;
@@
  f(A)
+	/*__SEMREF__*/
EOF
  LD_LIBRARY_PATH="$SEMREF_HOME/usr/lib64" COCCINELLE="$SEMREF_HOME/usr/lib64/coccinelle" \
    timeout 900 "$SPATCH" --sp-file "$WORK/call.cocci" --dir "$root" 2>/dev/null | parse_calls "$sym" | LC_ALL=C sort -u
}

emit() {  # <fichero-sitios> <etiqueta>
  local sites="$1" tag="$2" f l
  [ -s "$sites" ] || return 0
  while IFS=$'\t' read -r f l; do
    [ -z "$f" ] && continue
    printf '%-11s %s:%s  %s\n' "$tag" "$f" "$l" "$(enclosing "$f" "$l")"
  done < "$sites"
}

cmd_refs() {
  local sym="$1" root="$2" ndef ncalls
  awk -F'\t' -v s="$sym" '$1==s {print $3"\t"$2}' "$WORK/index.tsv" > "$WORK/defs.tsv"
  call_sites "$sym" "$root" > "$WORK/calls.tsv"
  ndef=$(wc -l < "$WORK/defs.tsv")
  ncalls=$(wc -l < "$WORK/calls.tsv")
  if [ "$ndef" -eq 0 ] && [ "$ncalls" -eq 0 ]; then
    echo "SIN-MATCH :: $sym"; return 0
  fi
  emit "$WORK/defs.tsv" DEFINITION
  emit "$WORK/calls.tsv" CALL
  printf 'TOTAL %s definicion=%s llamadas=%s suma=%s\n' "$sym" "$ndef" "$ncalls" "$((ndef+ncalls))"
}

cmd_chain() {
  local sym="$1" root="$2" depth="$3" level=0
  printf 'CHAIN %s depth<=%s\n' "$sym" "$depth"
  echo "$sym" > "$WORK/seen.txt"
  while [ "$level" -lt "$depth" ]; do
    : > "$WORK/front.txt"
    while read -r s; do
      [ -z "$s" ] && continue
      call_sites "$s" "$root" >> "$WORK/front.txt"
    done < "$WORK/seen.txt"
    LC_ALL=C sort -u "$WORK/front.txt" > "$WORK/front.u"
    : > "$WORK/next.txt"
    while IFS=$'\t' read -r f l; do
      [ -z "$f" ] && continue
      awk -F'\t' -v F="$f" '$1==F{found=1} END{exit !found}' "$WORK/seen.txt" 2>/dev/null || echo "$f" >> "$WORK/next.txt"
    done < "$WORK/front.u"
    LC_ALL=C sort -u "$WORK/next.txt" -o "$WORK/next.txt"
    [ ! -s "$WORK/next.txt" ] && { echo "  (sin expansión en nivel $level — límite del árbol o sin callers)"; break; }
    while IFS=$'\t' read -r f l; do
      printf '  L%s CALLER %s:%s  %s\n' "$level" "$f" "$l" "$(enclosing "$f" "$l")"
    done < "$WORK/front.u"
    cp "$WORK/next.txt" "$WORK/seen.txt"
    level=$((level+1))
  done
}

case "${1:-}" in
  engines) engine_state; exit $? ;;
  refs)
    S="${2:?}"; shift 2; R="$PWD"
    while [ $# -gt 0 ]; do case "$1" in --root) R="$2"; shift 2;; *) shift;; esac; done
    engine_state >/dev/null || { echo "ENGINE-NOT-AVAILABLE: falta ctags o coccinelle; no se degrada en silencio" >&2; exit 3; }
    build_index "$R"; cmd_refs "$S" "$R" ;;
  chain)
    S="${2:?}"; shift 2; R="$PWD"; D=2
    while [ $# -gt 0 ]; do case "$1" in --root) R="$2"; shift 2;; --depth) D="$2"; shift 2;; *) shift;; esac; done
    engine_state >/dev/null || { echo "ENGINE-NOT-AVAILABLE: falta ctags o coccinelle; no se degrada en silencio" >&2; exit 3; }
    build_index "$R"; cmd_chain "$S" "$R" "$D" ;;
  *) echo "uso: semref refs|chain|engines [<símbolo>] [--root DIR] [--depth N]"; exit 2 ;;
esac
