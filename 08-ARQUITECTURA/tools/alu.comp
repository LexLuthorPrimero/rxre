#version 450
// KERNEL ALU: mide ANCHO de computo, no latencia.
// NACC cadenas independientes rompen la dependencia: la iteracion k+1 no espera a la k.
// Con NACC >= el numero de pasos de dependencia hardware, el limite pasa a ser el ancho
// de la ALU en lugar de la latencia de una multiplicacion.
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITERS  = 1u;
layout(constant_id = 1) const uint NACC   = 8u;
layout(std430, binding = 0) buffer B { uint d[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint a[NACC];
    for (uint c = 0u; c < NACC; c++) a[c] = d[i + c] + c * 7919u;
    for (uint k = 0u; k < ITERS; k++) {
        #pragma unroll
        for (uint c = 0u; c < NACC; c++) {
            uint x = a[c];
            x = x * 1664525u + 1013904223u;
            x ^= (x >> 13);
            x = x * 1103515245u + 12345u;
            a[c] = x;
        }
    }
    uint s = 0u;
    for (uint c = 0u; c < NACC; c++) s ^= a[c];
    d[i] = s;
}
