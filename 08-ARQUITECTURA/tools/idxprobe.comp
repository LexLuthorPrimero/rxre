#version 450
// DIAGNOSTICO, no medicion: escribe el INDICE que el hash produce, sin cadena ni lectura.
// sirve para separar "el hash del shader no es el que creo" de "el modelo esta mal".
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITERS = 1u;
layout(constant_id = 1) const uint WSIZE = 1024u;
layout(std430, binding = 0) buffer B { uint d[]; };
uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}
void main() {
    uint i = gl_GlobalInvocationID.x;
    d[i] = hash(i + 0x9e3779b9u) % WSIZE;   /* el indice, crudo */
}
