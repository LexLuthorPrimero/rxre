#version 450
// DISCRIMINANTE de 277-1. La pregunta: ¿los 7,0 ciclos son trabajo real o el bucle
// se esta optimizando? Se responde variando el trabajo POR ITERACION y mirando si el
// tiempo marginal escala con el.
//   STEPS = pasos de hash por iteracion (constant_id=2, uno por iteracion).
// Si el hardware ejecuta la cadena, el coste por iteracion escala con STEPS.
// Si el bucle se optimiza, el coste se queda igual.
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITERS = 1u;
layout(constant_id = 1) const uint WSIZE = 1024u;
layout(constant_id = 2) const uint STEPS = 1u;
layout(std430, binding = 0) buffer B { uint d[]; };
uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint idx = hash(i + 0x9e3779b9u) % WSIZE;
    uint acc  = 0u;
    for (uint k = 0u; k < ITERS; k++) {
        uint v = d[idx];
        acc = acc * 1664525u + v + 1013904223u;
        idx = acc % WSIZE;
        for (uint s = 0u; s < STEPS; s++) {
            /* El % WSIZE va DENTRO del bucle, no despues. Sin el, idx queda siendo un
             * hash completo de 32 bits y la vuelta siguiente lee d[idx] fuera del
             * buffer en cuanto ITERS>=2. Corregido en 278: la version anterior no lo
             * tenia y el banco abortaba con 4 porque el modelo del host replicaba el
             * mismo defecto mientras el hardware devolvia 0. */
            idx = hash(idx) % WSIZE;  /* cadena pura: cada paso depende del anterior */
        }
        acc = acc + idx;
    }
    /* Escritura en la region disjunta de la lectura. Ver occ.comp y 282. */
    d[WSIZE + i] = acc;
}
