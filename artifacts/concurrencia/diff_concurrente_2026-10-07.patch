+# ---------------------------------------------------------------------------
+# Vertical Slice: QUESTION → EVIDENCE → RELATION → CLAIM → NEXT ACTION
+# ---------------------------------------------------------------------------
+
+def construir_vertical_slice_soft_regs_start(
+    c: sqlite3.Connection,
+    producer_op_id: str = "",
+    consumer_res_id: str = "",
+    target: str = "1002:699f@c7",
+    offset: str = "0xA21",
+    session: str = "soft_regs_start_slice",
+) -> Dict[str, Any]:
+    """
+    Construir la cadena vertical completa para soft_regs_start:
+    
+    QUESTION: ¿Qué inicializa soft_regs_start en Polaris12/gfx_8_0?
+      ↓
+    EVIDENCE: Registro 0xA21, definiciones de kernel, PM4 SHADOW_START
+      ↓
+    RELATION: PRODUCER → TRANSFORMS → REPRESENTS → CONSUMES → AFFECTS
+      ↓
+    CLAIM: "soft_regs_start is populated from SoftRegisters" (PARTIAL, HUECO_DE_EVIDENCIA)
+      ↓
+    NEXT_ACTION: Resolver la siguiente relación faltante (SHADOW_START → soft_regs_start)
+    
+    RETORNA: dict con relation_id, claim_id, next_action_id
+    """
+    from .store import registrar_investigacion, investigacion
+    
+    ts = time.strftime("%Y-%m-%dT%H:%M:%S%z")
+    
+    # 1. Registrar operación productora (lectura del registro 0xA21)
+    op_id = producer_op_id or f"op_softregs_prod_{int(time.time())}"
+    c.execute("""
+        INSERT OR REPLACE INTO operations
+        (operation_id, request_id, contract_ver, operacion, capability, question, target, scope, status, n_results, request_json, response_json, target_pci, timestamp, duracion_s)
+        VALUES (?, '', 'v1', 'register_read', 'register.definition', 'What initializes soft_regs_start?', ?, 'read', 'ok', 1, '{}', '{}', '', ?, 0.0)
+    """, (op_id, target, ts))
+    
+    # 2. Registrar resultado: valor del registro 0xA21
+    res_id = consumer_res_id or f"res_softregs_val_{int(time.time())}"
+    c.execute("""
+        INSERT OR REPLACE INTO results
+        (result_id, operation_id, type, value, source, file, line, scope, tool, tool_version, status, raw_json, timestamp)
+        VALUES (?, ?, 'register', '0xA21_val', 'reg_resolve.py', 'drivers/gpu/drm/amd/include/asic_reg/gfx8/...', 0, 'read', 'reg_resolve', '0.1', 'ok', '{}', ?)
+    """, (res_id, op_id, ts))
+    c.commit()
+    
+    # 3. Registrar cadena de relación causal
+    relation_id = f"chain_softregs_start_{int(time.time())}"
+    cadena_id = registrar_cadena(
+        c,
+        relation_id=relation_id,
+        producer=op_id,
+        transformation="bits_extract_dword_index",
+        representation="soft_regs_start_dword",
+        consumer=res_id,
+        effect="register_write_enabled",
+        relation_type="PRODUCES",
+        epistemic_state="PARTIAL",
+        target=target,
+        offset=offset,
+        context="soft_regs_start initialization on gfx_8_0",
+        provenance_json=json.dumps([f"res_{res_id}"]),
+        evidence_json=json.dumps([f"res_{res_id}"]),
+        confidence=0.7,
+        limitations="transformation based on pattern match; SHADOW_START link not yet proven",
+        created_by=session,
+    )
+    
+    if not cadena_id:
+        return {"status": "error", "message": "Failed to register relation chain"}
+    
+    # 4. Registrar claim
+    claim_id = registrar_investigacion(
+        c, "claim", "soft_regs_start is populated from SoftRegisters",
+        status="PARTIAL",
+        refs=[res_id],
+        session=session,
+        target=target,
+        gap_kind="HUECO_DE_EVIDENCIA",
+    )
+    
+    if claim_id.get("estado") != "ok":
+        return {"status": "error", "message": f"Failed to register claim: {claim_id}"}
+    
+    # 5. Registrar next_action
+    next_action_id = registrar_investigacion(
+        c, "next_action", "resolve SHADOW_START PM4 packet to soft_regs_start link",
+        status="OPEN",
+        refs=[res_id],
+        session=session,
+        target=target,
+    )
+    
+    if next_action_id.get("estado") != "ok":
+        return {"status": "error", "message": f"Failed to register next_action: {next_action_id}"}
+    
+    c.commit()
+    
+    return {
+        "status": "ok",
+        "relation_id": relation_id,
+        "claim_id": claim_id.get("id"),
+        "next_action_id": next_action_id.get("id"),
+        "session": session,
+        "target": target,
+        "offset": offset,
+        "producer": op_id,
+        "consumer": res_id,
+    }
+
+
