#version 450
// Tres modos de carga en un solo kernel, elegidos con un push constant.
//   mode 0 = fill : escritura pura
//   mode 1 = rmw  : lectura + modificacion + escritura.  Es el modo por defecto: es el que
//                   mas carga genera en el memory hub, que es lo que queremos saturar.
//   mode 2 = math : cadena FMA larga por elemento, carga de ALU mas que de memoria
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { uint data[]; };
layout(push_constant) uniform PC { uint mode; uint iters; } pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (pc.mode == 0u) {
        data[i] = 0xdeadbeefu;
    } else if (pc.mode == 1u) {
        uint v = data[i];
        v ^= v << 13;
        v ^= v >> 17;
        v ^= v << 5;
        data[i] = v;
    } else {
        uint v = data[i] | 1u;
        for (uint k = 0u; k < pc.iters; ++k)
            v = v * 1664525u + 1013904223u;
        data[i] = v;
    }
}
