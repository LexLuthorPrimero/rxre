# Kbuild wrapper for the rx550 exclusive driver.
#
# Kbuild needs to be invoked from the kernel's build tree with M=$(PWD), so the
# real object rules live in scripts/Makefile.build and we only declare what to
# build. Calling `make` directly in this directory therefore recurses back into
# the kernel tree.
#
#
# CORREGIDO POR 091. Lo que decia antes aqui era FALSO, y estaba escrito en el
# codigo fuente, que es el sitio donde un error se propaga solo.
#
# La version anterior de este comentario afirmaba:
#   "this host has CONFIG_MODULE_SIG_ALL=y and CONFIG_SECURITY_LOCKDOWN_LSM=y,
#    and the signing key is not present under /etc/pki. A module built here is
#    unsigned, and lockdown rejects unsigned modules before the signature is
#    even examined. So `make` succeeds and `insmod` will not."
#
# Eso es medio verdad y la mitad falsa es la que importa: se leyo
# CONFIG_MODULE_SIG_ALL y NO se leyo CONFIG_MODULE_SIG_FORCE, que es el que hace
# obligatoria la firma.
#
# MEDIDO en este host:
#   CONFIG_MODULE_SIG_ALL=y            obliga a firmar SOLO los modulos del arbol
#   # CONFIG_MODULE_SIG_FORCE is not set   <-- el que obliga, y NO esta
#   /sys/kernel/security/lockdown      = [none]
#   mokutil --sb-state                 = SecureBoot disabled
#   /proc/cmdline                      sin lockdown= ni module.sig_enforce=
#   modinfo amdgpu.ko.zst              signer: Build time autogenerated kernel key
#   modinfo rx550_probe.ko             signer: (ninguno)   <-- SIN FIRMAR
#   rx550_probe.ko                     370504 B, vermagic IDENTICO al kernel
#                                      en ejecucion, COMPILA, SIN FIRMAR
#
# Conclusion: `make` funciona Y `insmod` tambien puede funcionar. Lo que impide
# cargar no es tecnico: es NIVEL 4 (insmod), que AGENTS.md 76-82 somete a
# autorizacion humana explicita. Ver 091.
#
# Y el objetivo de este arbol de codigo acaba de cambiar por eso: no hace falta
# un truco para cargar, hace falta la autorizacion. Ver kernel/README.md.

# rx550_mmio.c entra en este modulo, y lo hace por la via de #include desde
# rx550_drv.c, NO como objeto compuesto. No es una cuestion de gusto: es una
# colision de nombres en kbuild que se midio y se reproduce con dos ficheros
# triviales.
#
# Si se escribiera
#
#     rx550_drv-y := rx550_drv.o rx550_mmio.o
#     obj-m += rx550_drv.o
#
# Y esa es exactamente la forma que se probo primero. La version anterior de
# este comentario la daba como ERRONEA, y no lo es: `-y` es la forma que usa
# amdgpu (arriba, linea 51 de su Makefile) y el fallo no era de forma, era de
# nombres. Un diagnostico atribuido a la sintaxis cuando la causa es otra cosa
# deja el sintoma volver cuando se corrige lo que no era.
#
# el .o del MODULO y el .o del MIEMBRO son el mismo fichero. Make resuelve el
# enlace del compuesto y da por satisfecho el miembro, de modo que
# rx550_drv.c NO SE COMPILA NUNCA. Reproducido en /tmp/opencode/kbtest2 con dos
# ficheros triviales: el .ko se produce, sin un solo error, y el miembro que
# colisiona no esta dentro. El unico sintoma es el modinfo que el miembro
# perdido aportaba: aqui, MODULE_LICENSE, y por eso modpost protesta con
# "missing MODULE_LICENSE() in rx550_drv.o" -- un mensaje que senala una
# licencia y senala un fichero que si la tiene.
#
# Peor es el caso silencioso: si rx550_mmio.c aportara MODULE_LICENSE en vez de
# rx550_drv.c, el modulo construiria sin avisar y sin el codigo del driver PCI.
# Un fallo que se ve es un fallo; uno que se lleva el codigo por delante y no
# dice nada es peor.
#
# La forma que evita la colision es que el objeto con el nombre del modulo
# NUNCA sea miembro de si mismo. Y eso no es una regla inventada a partir de una
# mala experiencia: es lo que hace el corpus ENTERO, y se recalcula con
#
#     python3 tools/lint.py --censo
#
#     declaraciones de objeto compuesto en el corpus:   87
#     el .o del modulo NO es miembro:                   87
#     el .o del modulo SI es miembro:                    0
#
# Y amdgpu lo dice con su propio nombre, que es donde se ve la diferencia de
# criterio:
#
#     amdgpu/Makefile:51    amdgpu-y := amdgpu_drv.o
#
# El modulo se llama amdgpu y su primer objeto se llama amdgpu_drv.o. El sufijo
# _drv va en el MODULO ahi y en el FICHERO aqui, y los dos evitan la misma
# colision. La version anterior de este comentario decia "i915_core.o, no
# i915.o; amdgpu_kms.o, no amdgpu.o" de memoria, sin un solo fichero del proyecto
# que lo dijera, y la segunda pareja era incorrecta: lo que amdgpu evita no es
# amdgpu_kms.o, es amdgpu.o. Un criterio necesita su fuente, no un recuerdo.
#
# Aqui no se puede renombrar
# rx550_drv.c a rx550_pci.c para evitarlo, porque 5 hallazgos inmutables citan
# rx550_drv.c:N y los hallazgos no se reescriben: 114, 171 y 189. Un fichero
# renombrado rompe citas que por regla ya no se pueden arreglar. Asi que el
#include desde rx550_drv.c, que deja el nombre del objeto igual de intacto.
obj-m += rx550_drv.o

# rx550.ko -- el char device de la Ronda 1. SE MANTIENE, pero ya no es el
# camino principal: no es un driver PCI (no tiene struct pci_driver, no se
# registra con pci_register_driver, verificado con nm sobre el .ko) y un char
# device no puede dar a userspace un BAR mapeado, que es lo que un driver de
# GPU necesita. Ver 07-DRIVER/kernel/STAGE1-SUBSYSTEMS.md.
#
# Se sigue compilando para que su codigo no se pudra, y porque rx550_pm4.c
# (el codificador PM4) tiene una suite de pruebas que depende de el.
obj-m += rx550.o

# rx550_pm4.o is the packet encoder. It is listed here even though nothing calls
# it yet: SUBMIT_COMPUTE is a stub, so the encoder has no caller in the kernel.
# Building it anyway means the kernel build is what proves it compiles against
# kernel headers, rather than the userspace test being the only check. The
# test compiles the same .c, so a packet the test validates is the packet this
# object encodes.
rx550-objs := rx550_main.o rx550_pm4.o

KERNELRELEASE ?= $(shell uname -r)
KERNELDIR    := /lib/modules/$(KERNELRELEASE)/build

.PHONY: all modules clean check-kernel check-config check-drivers

all: modules

modules:
	$(MAKE) -C $(KERNELDIR) M=$(CURDIR) modules

clean:
	$(MAKE) -C $(KERNELDIR) M=$(CURDIR) clean

# Fails loudly if the kernel build tree is missing, rather than emitting a
# confusing "No rule to make target" from inside scripts/Makefile.build.
check-kernel:
	@test -d $(KERNELDIR) || { \
	  echo "ERROR: kernel build tree not found: $(KERNELDIR)"; \
	  exit 1; }
	@echo "  kernel build tree: $(KERNELDIR)"

# Reports the configs that decide whether a locally built module can be loaded.
# Read-only: this does not build, and it does not change the running system.
check-config:
	@echo "  kernel: $(KERNELRELEASE)"
	@conf=$(KERNELDIR)/include/config/auto.conf; \
	 test -f $$conf || { echo "  ERROR: no auto.conf, is the tree configured?"; exit 1; }; \
	 for c in CONFIG_MODVERSIONS CONFIG_MODULE_SIG_ALL CONFIG_SECURITY_LOCKDOWN_LSM; do \
	   v=$$(grep -E "^$$c=|^# $$c is not set" $$conf | head -1); \
	   printf '  %-34s %s\n' "$$c" "$${v:-<not present>}"; \
	 done; \
	 echo "  CONFIG_MODULE_SIG_KEY: $$(grep -E '^CONFIG_MODULE_SIG_KEY=' $$conf | cut -d= -f2-)"

# Comprobacion estatica de la etapa 1. No carga nada, no cambia el sistema.
# Cada comprobacion tiene un control negativo: si el simbolo buscado aparece,
# el objetivo falla. Sin el control contrario, "no encontre X" y "no hay X" son
# la misma frase, y aqui no pueden serlo.
check-drivers:
	@echo "== modulos =="
	@for m in rx550_drv.ko rx550.ko; do \
	  if [ -f $$m ]; then \
	    printf '  %-16s %7d B  srcversion %s\n' "$$m" "$$(stat -c%s $$m)" \
	      "$$(modinfo -F srcversion $$m)"; \
	  else printf '  %-16s NO CONSTRUIDO\n' "$$m"; exit 1; fi; \
	done
	@echo "== rx550_drv.ko DEBE ser driver PCI (positivo) =="
	@for s in __pci_register_driver pci_unregister_driver pci_enable_device \
	          pci_request_regions; do \
	  nm rx550_drv.ko | grep -qE " U $$s$$" \
	    && echo "  OK    U $$s" || { echo "  FALTA $$s"; exit 1; }; \
	done
	@nm rx550_drv.ko | grep -qE " d rx550_pci_driver$$" \
	  && echo "  OK    d rx550_pci_driver" || { echo "  FALTA struct pci_driver"; exit 1; }
	@echo "== rx550.ko NO debe ser driver PCI (negativo) =="
	@if nm rx550.ko | grep -qE "pci_register_driver|pci_driver"; then \
	  echo "  FALLO: rx550.ko ahora es driver PCI; el supuesto del informe cambio"; exit 1; \
	else echo "  OK    0 simbolos pci"; fi
	@# CORREGIDO. Este check decia "la etapa 1 NO mapea MMIO" y paso a fallar
	@# en cuanto el mapeo llego, que es justo cuando el trabajo avanzo. Un check
	@# negativo que se vuelve falso cuando el avance ocurre no estaba
	@# custodiando nada: estaba custodiando el estado viejo.
	@#
	@# Lo que sustituye es MAS FUERTE, no mas flojo: no basta con que no haya
	@# mapeo, exige que el mapeo este DETRAS de la validacion del contrato, y eso
	@# se comprueba por ORDEN de linea, que es falsable.
# SIN COMENTARIOS, y por que. La primera version de este check busco las
# llamadas con grep a pelo y fallo por la linea 343, que era un comentario que
# NOMBRA pci_iomap() al explicar por que el mapa va detras de la comprobacion.
# Es el mismo fallo que ya mide drvchain con la clase NOMBRADO: un nombre en un
# comentario no es una llamada, y un control que se dispara por su propia
# documentacion no vigila nada.
#
# El sed de abajo quita las tres formas que aparecen en este fichero: un bloque
# /* ... */ entero en una linea, un // de linea entera, y un // al final. La
# version intermedia solo cubria las dos ultimas, y dos comentarios de una linea
# que nombraban las llamadas lo hacian fallar otra vez. Falsar un check por su
# propia documentacion y tener que arreglarlo dos veces es la forma mas clara de
# que el filtro, y no el check, era lo que estaba mal.
#
# Y van a columna 0 y antes de la receta a proposito: dentro de una receta un
# tabulador convierte la linea en orden de shell, y lo que se pretendia
# documentar se ejecutaba. Con los parentesis de pci_iomap() sin cotizar, el
# shell protestaba con un error de sintaxis que no señalaba la causa.
	@echo "== el mapeo de MMIO va DETRAS del contrato, no al reves =="
	@for m in rx550_drv.ko rx550.ko; do \
	  n=$$(nm $$m | grep -cE ' U (pci_iomap|pci_iomap_range|devm_ioremap|ioremap|__ioremap)'); \
	  if [ "$$n" -eq 0 ]; then \
	    echo "  OK    $$m: sin llamadas de mapeo, nada que ordenar"; \
	  elif [ "$$m" = "rx550.ko" ]; then \
	    echo "  FALLO $$m: $$n llamadas de mapeo y este modulo no deberia mapear"; exit 1; \
	  else \
	    codigo=$$(sed -e '/^[[:space:]]*\/\*/,/\*\//d' -e '/^[[:space:]]*\/\//d' -e 's://.*::' rx550_drv.c); \
	    v=$$(echo "$$codigo" | grep -n 'rx550_mmio_valida(' | head -1 | cut -d: -f1); \
	    i=$$(echo "$$codigo" | grep -n 'pci_iomap(' | head -1 | cut -d: -f1); \
	    if [ -z "$$v" ] || [ -z "$$i" ]; then \
	      echo "  FALLO $$m: hay $$n llamadas de mapeo pero no se localiza el par"; exit 1; \
	    elif [ "$$v" -lt "$$i" ]; then \
	      echo "  OK    $$m: valida en linea $$v y mapea en linea $$i, el mapa va detras"; \
	    else \
	      echo "  FALLO $$m: mapea en linea $$i ANTES de validar en linea $$v"; exit 1; \
	    fi; \
	  fi; \
	done
	@echo "== el codigo del contrato MMIO esta DENTRO del modulo =="
	@for s in rx550_mmio_deriva rx550_mmio_valida rx550_mmio_offset_ok rx550_mmio_motivo; do \
	  nm rx550_drv.ko | grep -qE " [Tt] $$s$$" \
	    && echo "  OK    $$s presente en rx550_drv.ko" \
	    || { echo "  FALLO $$s NO esta en rx550_drv.ko"; exit 1; }; \
	done
	@echo "== tabla de identidades expuesta a udev (alias) =="
	@modinfo rx550_drv.ko | sed -n 's/^alias: */  /p' | head -1
	@echo "== dependencias de carga =="
	@echo "  depends: '$$(modinfo -F depends rx550_drv.ko)'  (vacio: CONFIG_DRM=y, DRM es built-in)"
	@echo "== vermagic contra el kernel en ejecucion =="
	@echo "  modinfo: $$(modinfo -F vermagic rx550_drv.ko)"
	@echo "  uname:   $$(uname -r)"
	@echo "OK: comprobaciones estaticas superadas"
