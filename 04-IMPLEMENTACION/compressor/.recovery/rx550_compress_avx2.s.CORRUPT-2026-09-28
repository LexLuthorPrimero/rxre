/* SPDX-License-Identifier: MIT
 *
 * rx550_compress_avx2.s - AVX2 per-channel min/max reduction.
 *
 * For one 4x4 RGBA8 block (64 bytes = 16 pixels x 4 bytes, R,G,B,A order):
 *
 *     out[0..3] = min(R,G,B,A)      out[4..7] = max(R,G,B,A)
 *
 * Why this part and not the whole codec: the reduction is branchless,
 * data-parallel, and runs the same instruction count whatever the pixel values
 * are. Palette construction and index search are per-pixel branchy work where
 * SIMD buys little and correctness risk is high, so they stay in C.
 *
 * Must be BIT-IDENTICAL to rx550_minmax_c(). Integer min/max is associative
 * and exact, so reduction order cannot change the result -- an argument, not a
 * proof. test_compress.c compares both implementations on 200k blocks on every
 * run, which is the proof.
 *
 * SysV AMD64 ABI:  rdi = src (64 bytes), rsi = out (8 bytes).
 * AT&T syntax: operands read right-to-left, OP %src2, %src1, %dst.
 *
 * ===========================================================================
 * HISTORY OF THE THREE BUGS THIS DESIGN FIXES. DO NOT REINTRODUCE ANY OF THEM.
 * ===========================================================================
 *
 * (1) GAS MACROS. v1 used .macro for the horizontal reduction and the
 *     per-channel block. Inside a .macro body "%name" means "substitute
 *     parameter name", so a literal register must be "%%ymm0", and that escape
 *     does not survive a *nested* macro invocation. Result: "nombre de
 *     registro incorrecto", plus a real risk that a wrong expansion assembles
 *     into a wrong instruction. There are no macros here. The repetition is
 *     deliberate.
 *
 * (2) WRONG DEINTERLEAVE. v2 used VPERMD with index vectors {c, c+4, c+8, ...}
 *     to "pull out channel c". A pixel is one 32-bit dword, so index 4 selects
 *     pixel 4, not a byte lane; indices 8..31 were out of range for a YMM and
 *     returned zero. The primitive for byte extraction is VPSHUFB, which works
 *     within a 128-bit lane.
 *
 * (3) GATHER IS NOT REDUCE. v3 used the right VPSHUFB but then "folded" the
 *     four useful bytes with more VPSHUFB gathers. A gather COPIES bytes, it
 *     does not combine them -- the result silently came out as the low values
 *     or as padding. The four useful bytes have to be spread into four
 *     separate dwords first, and then combined with VPSHUFD + VPMINUB, which
 *     operate on dword positions while VPMINUB still applies bytewise.
 *
 * ===========================================================================
 *
 * Plane extraction geometry (this is the part that must be right):
 *
 *   VPSHUFB is per-128-bit-lane, and a lane holds 4 pixels. To gather channel c
 *   we take source bytes {c, c+4, c+8, c+12} -- one per pixel -- and place them
 *   at destination byte offsets 0, 4, 8, 12 so that each lands in its own
 *   dword. The 12 remaining destination bytes are padding and must be neutral
 *   for the operation being performed: 0xFF for a minimum, 0x00 for a maximum.
 *   That is why there are eight tables rather than four.
 *
 *   After both planes are folded together with VPMINUB/VPMAXUB, the four
 *   surviving values sit at bytes 0, 4, 8, 12 of xmm0 and the rest is padding.
 *   Then:  VPSHUFD $0x4e swaps the 64-bit halves, VPMINUB folds 0 against 2
 *   and 1 against 3;  VPSHUFD $0xb1 then VPMINUB folds the pair against the
 *   padding and duplicates the result into two dwords;  finally a two-byte
 *   swap plus one more VPMINUB puts min(even,odd) in byte 0.
 */

	.text

/* ------------------------------------------------------------------------- */
/* Plane masks, YMM form: one 16-byte mask duplicated for both 128-bit lanes. */
/* ------------------------------------------------------------------------- */
	.section .rodata
	.balign 32

/* --- channel R: source bytes 0,4,8,12 ------------------------------------- */
.Lpl_r_min:				/* 0xFF padding: neutral for MINIMUM */
	.byte   0,0xFF,0xFF,0xFF, 4,0xFF,0xFF,0xFF, 8,0xFF,0xFF,0xFF, 12,0xFF,0xFF,0xFF
	.byte   0,0xFF,0xFF,0xFF, 4,0xFF,0xFF,0xFF, 8,0xFF,0xFF,0xFF, 12,0xFF,0xFF,0xFF
.Lpl_r_max:				/* 0x00 padding: neutral for MAXIMUM */
	.byte   0,0,0,0, 4,0,0,0, 8,0,0,0, 12,0,0,0
	.byte   0,0,0,0, 4,0,0,0, 8,0,0,0, 12,0,0,0

/* --- channel G: source bytes 1,5,9,13 -------------------------------------- */
.Lpl_g_min:
	.byte   1,0xFF,0xFF,0xFF, 5,0xFF,0xFF,0xFF, 9,0xFF,0xFF,0xFF, 13,0xFF,0xFF,0xFF
	.byte   1,0xFF,0xFF,0xFF, 5,0xFF,0xFF,0xFF, 9,0xFF,0xFF,0xFF, 13,0xFF,0xFF,0xFF
.Lpl_g_max:
	.byte   1,0,0,0, 5,0,0,0, 9,0,0,0, 13,0,0,0
	.byte   1,0,0,0, 5,0,0,0, 9,0,0,0, 13,0,0,0

/* --- channel B: source bytes 2,6,10,14 ------------------------------------- */
.Lpl_b_min:
	.byte   2,0xFF,0xFF,0xFF, 6,0xFF,0xFF,0xFF, 10,0xFF,0xFF,0xFF, 14,0xFF,0xFF,0xFF
	.byte   2,0xFF,0xFF,0xFF, 6,0xFF,0xFF,0xFF, 10,0xFF,0xFF,0xFF, 14,0xFF,0xFF,0xFF
.Lpl_b_max:
	.byte   2,0,0,0, 6,0,0,0, 10,0,0,0, 14,0,0,0
	.byte   2,0,0,0, 6,0,0,0, 10,0,0,0, 14,0,0,0

/* --- channel A: source bytes 3,7,11,15 ------------------------------------- */
.Lpl_a_min:
	.byte   3,0xFF,0xFF,0xFF, 7,0xFF,0xFF,0xFF, 11,0xFF,0xFF,0xFF, 15,0xFF,0xFF,0xFF
	.byte   3,0xFF,0xFF,0xFF, 7,0xFF,0xFF,0xFF, 11,0xFF,0xFF,0xFF, 15,0xFF,0xFF,0xFF
.Lpl_a_max:
	.byte   3,0,0,0, 7,0,0,0, 11,0,0,0, 15,0,0,0
	.byte   3,0,0,0, 7,0,0,0, 11,0,0,0, 15,0,0,0

/* --- final 2-byte swap, XMM form (16 bytes) -------------------------------- */
.Lswap01:
	.byte   1, 0, 0x80,0x80, 0x80,0x80,0x80,0x80, 0x80,0x80,0x80,0x80, 0x80,0x80,0x80,0x80

	.text

/* ------------------------------------------------------------------------- */
	.globl	rx550_minmax_avx2
	.type	rx550_minmax_avx2, @function
rx550_minmax_avx2:
	.cfi_startproc

	/* Two 256-bit loads: 8 pixels each, all 16 covered. */
	vmovdqu	0(%rdi), %ymm0			/* pixels 0..7  */
	vmovdqu	32(%rdi), %ymm1			/* pixels 8..15 */

/* ========================================================================= */
/* CHANNEL R                                                                  */
/* ========================================================================= */
	/* ---- minimum ------------------------------------------------------- */
	vmovdqu	.Lpl_r_min(%rip), %ymm4		/* unaligned form: the table is
						   32-byte aligned, but using the
						   unaligned load keeps that an
						   implementation detail */
	vpshufb	%ymm4, %ymm0, %ymm2		/* R of px 0..7,  pad 0xFF */
	vpshufb	%ymm4, %ymm1, %ymm3		/* R of px 8..15, pad 0xFF */
	vpminub	%ymm3, %ymm2, %ymm5		/* bytewise min over 16 pixels */
	vextracti128	$1, %ymm5, %xmm1	/* fold the two 128-bit lanes */
	vpminub	%xmm6, %xmm5, %xmm5		/* 4 values at bytes 0,4,8,12 */

	vpshufd	$0x4e, %xmm5, %xmm6		/* swap 64-bit halves: {2,3,0,1} */
	vpminub	%xmm6, %xmm5, %xmm5		/* fold 0 against 2, 1 against 3 */
	vpshufd	$0xb1, %xmm5, %xmm6		/* swap 32-bit pairs:  {1,0,3,2} */
	vpminub	%xmm6, %xmm5, %xmm5		/* duplicate the pair, pad folds in */
	/* byte 0 already holds the answer: the vpshufd $0xb1 fold above put it
	 * there. No further gather is needed -- and VPSHUFB with an index whose
	 * high bit is set yields 0x00, which would win every vpminub and force the
	 * minimum to zero. */
	vmovd	%xmm5, %eax
	movb	%al, 0(%rsi)

	/* ---- maximum ------------------------------------------------------- */
	vmovdqu	.Lpl_r_max(%rip), %ymm4
	vpshufb	%ymm4, %ymm0, %ymm2		/* R of px 0..7,  pad 0x00 */
	vpshufb	%ymm4, %ymm1, %ymm3		/* R of px 8..15, pad 0x00 */
	vpmaxub	%ymm3, %ymm2, %ymm6
	vextracti128	$1, %ymm6, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vpshufd	$0x4e, %xmm5, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vpshufd	$0xb1, %xmm5, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vpshufb	.Lswap01(%rip), %xmm5, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vmovd	%xmm5, %eax
	movb	%al, 4(%rsi)

/* ========================================================================= */
/* CHANNEL G                                                                  */
/* ========================================================================= */
	vmovdqu	.Lpl_g_min(%rip), %ymm4
	vpshufb	%ymm4, %ymm0, %ymm2
	vpshufb	%ymm4, %ymm1, %ymm3
	vpminub	%ymm3, %ymm2, %ymm5
	vextracti128	$1, %ymm5, %xmm6
	vpminub	%xmm6, %xmm5, %xmm5
	vpshufd	$0x4e, %xmm5, %xmm6
	vpminub	%xmm6, %xmm5, %xmm5
	vpshufd	$0xb1, %xmm5, %xmm6
	vpminub	%xmm6, %xmm5, %xmm5
	vpshufb	.Lswap01(%rip), %xmm5, %xmm6
	vpminub	%xmm6, %xmm5, %xmm5
	vmovd	%xmm5, %eax
	movb	%al, 1(%rsi)

	vmovdqu	.Lpl_g_max(%rip), %ymm4
	vpshufb	%ymm4, %ymm0, %ymm2
	vpshufb	%ymm4, %ymm1, %ymm3
	vpmaxub	%ymm3, %ymm2, %ymm6
	vextracti128	$1, %ymm6, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vpshufd	$0x4e, %xmm5, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vpshufd	$0xb1, %xmm5, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vpshufb	.Lswap01(%rip), %xmm5, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vmovd	%xmm5, %eax
	movb	%al, 5(%rsi)

/* ========================================================================= */
/* CHANNEL B                                                                  */
/* ========================================================================= */
	vmovdqu	.Lpl_b_min(%rip), %ymm4
	vpshufb	%ymm4, %ymm0, %ymm2
	vpshufb	%ymm4, %ymm1, %ymm3
	vpminub	%ymm3, %ymm2, %ymm5
	vextracti128	$1, %ymm5, %xmm6
	vpminub	%xmm6, %xmm5, %xmm5
	vpshufd	$0x4e, %xmm5, %xmm6
	vpminub	%xmm6, %xmm5, %xmm5
	vpshufd	$0xb1, %xmm5, %xmm6
	vpminub	%xmm6, %xmm5, %xmm5
	vpshufb	.Lswap01(%rip), %xmm5, %xmm6
	vpminub	%xmm6, %xmm5, %xmm5
	vmovd	%xmm5, %eax
	movb	%al, 2(%rsi)

	vmovdqu	.Lpl_b_max(%rip), %ymm4
	vpshufb	%ymm4, %ymm0, %ymm2
	vpshufb	%ymm4, %ymm1, %ymm3
	vpmaxub	%ymm3, %ymm2, %ymm6
	vextracti128	$1, %ymm6, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vpshufd	$0x4e, %xmm5, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vpshufd	$0xb1, %xmm5, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vpshufb	.Lswap01(%rip), %xmm5, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vmovd	%xmm5, %eax
	movb	%al, 6(%rsi)

/* ========================================================================= */
/* CHANNEL A                                                                  */
/* ========================================================================= */
	vmovdqu	.Lpl_a_min(%rip), %ymm4
	vpshufb	%ymm4, %ymm0, %ymm2
	vpshufb	%ymm4, %ymm1, %ymm3
	vpminub	%ymm3, %ymm2, %ymm5
	vextracti128	$1, %ymm5, %xmm6
	vpminub	%xmm6, %xmm5, %xmm5
	vpshufd	$0x4e, %xmm5, %xmm6
	vpminub	%xmm6, %xmm5, %xmm5
	vpshufd	$0xb1, %xmm5, %xmm6
	vpminub	%xmm6, %xmm5, %xmm5
	vpshufb	.Lswap01(%rip), %xmm5, %xmm6
	vpminub	%xmm6, %xmm5, %xmm5
	vmovd	%xmm5, %eax
	movb	%al, 3(%rsi)

	vmovdqu	.Lpl_a_max(%rip), %ymm4
	vpshufb	%ymm4, %ymm0, %ymm2
	vpshufb	%ymm4, %ymm1, %ymm3
	vpmaxub	%ymm3, %ymm2, %ymm6
	vextracti128	$1, %ymm6, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vpshufd	$0x4e, %xmm5, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vpshufd	$0xb1, %xmm5, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vpshufb	.Lswap01(%rip), %xmm5, %xmm6
	vpmaxub	%xmm6, %xmm5, %xmm5
	vmovd	%xmm5, %eax
	movb	%al, 7(%rsi)

	/* Leave the upper YMM state clean so the next SSE code on this core does
	 * not pay an AVX-SSE transition penalty. */
	vzeroupper
	ret
	.cfi_endproc
	.size	rx550_minmax_avx2, .-rx550_minmax_avx2

	.section .note.GNU-stack,"",@progbits
