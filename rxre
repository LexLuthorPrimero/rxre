def _emit(resp, rc, args):
    """Emite la respuesta según modo (json/human) y devuelve exit code."""
    if args.json:
        print(json.dumps(resp, indent=2, ensure_ascii=False))
        return rc
    else:
        out, code = fmt_human(resp)
        print(out)
        return code


# ===========================================================================
# SUBCOMANDOS: HERRAMIENTAS INTEGRADAS
# ===========================================================================
def _run_script(script_path, args_list, human=True):
    """Ejecuta un script por subprocess.

    En modo human: hereda stdout/stderr del proceso hijo.
    En modo json: captura y reemite como JSON.
    """
    cmd = [sys.executable, "-B", script_path]
    if args_list:
        cmd.extend(args_list)
    env = preparar_entorno_subproceso()
    try:
        p = subprocess.run(cmd, capture_output=not human, text=True,
                           timeout=300, env=env)
    except subprocess.TimeoutExpired:
        print("rxre: timeout ejecutando %s" % os.path.basename(script_path),
              file=sys.stderr)
        return 1
    except FileNotFoundError:
        print("rxre: script no encontrado: %s" % script_path, file=sys.stderr)
        return 2

    if human:
        if p.stdout:
            sys.stdout.write(p.stdout)
        if p.stderr:
            sys.stderr.write(p.stderr)
    else:
        if p.stdout.strip():
            try:
                data = json.loads(p.stdout)
                print(json.dumps(data, indent=2, ensure_ascii=False))
            except json.JSONDecodeError:
                sys.stdout.write(p.stdout)
        if p.stderr:
            sys.stderr.write(p.stderr)
    return p.returncode


