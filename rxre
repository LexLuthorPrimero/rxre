def cmd_audit(args):
    """RXRE-ECO-001. Auditoria de una operacion con los ocho principios.

    `status: ok` del producer NO es lo mismo que operacion cerrada. Este
    subcomando dice si una operacion que ya se ejecuto se puede dar por
    cerrada, y si no, que principio lo impide.
    """
    script = os.path.join(RAIZ, "tools", "rxre", "audit_operacion.py")
    if not os.path.isfile(script):
        print("rxre audit: no encuentro %s" % script, file=sys.stderr)
        return 2
    argv_clean, _ = extract_flags(args.argv_after, ["--json", "--human"])
    env = preparar_entorno_subproceso()
    try:
        p = subprocess.run([sys.executable, "-B", script] + argv_clean,
                           capture_output=not args.json, text=True,
                           timeout=300, env=env)
    except subprocess.TimeoutExpired:
        print("rxre audit: timeout", file=sys.stderr)
        return 1
    if args.json:
        if p.stdout.strip():
            sys.stdout.write(p.stdout)
    else:
        if p.stdout:
            sys.stdout.write(p.stdout)
    if p.stderr:
        sys.stderr.write(p.stderr)
    return p.returncode


def cmd_mutate(args):
    """Ejecuta los scripts de mutation testing.

    CONTRACT verificado:
    - mutate_reg_resolve.py: copia a /tmp/opencode/ scratch, READONLY sobre el repo
    - mutate_relations.py:  copia a /tmp/opencode/ scratch, READONLY sobre el repo
    - mutate_target.py:     copia target.py a scratch, backup/restore (modifica
      target.py en el repo pero restaura). RAIZ corregido de hardcodeado a __file__.
    Todos: WRITES_GPU=no, TOUCHES_INTEGRATED=no
    """
    mutate_tools = [
        ("mutate_reg_resolve", os.path.join(RXRE_TOOLS, "mutate_reg_resolve.py")),
        ("mutate_relations", os.path.join(RXRE_TOOLS, "mutate_relations.py")),
        ("mutate_target", os.path.join(RXRE_TOOLS, "mutate_target.py")),
    ]

    # PRE-CHECK: verificar que los scripts existen
    missing = [name for name, path in mutate_tools if not os.path.isfile(path)]
    if missing:
        print("rxre mutate: scripts faltantes: %s" % ", ".join(missing),
              file=sys.stderr)
        return 2

    # PRE-CHECK: git status de target.py (mutate_target.py hace backup/restore)
    target_path = os.path.join(RXRE_PKG, "core", "target.py")
    if os.path.isfile(target_path):
        check = subprocess.run(
            ["git", "-C", RAIZ, "status", "--porcelain", target_path],
            capture_output=True, text=True
        )
        if check.stdout.strip():
            print("rxre mutate: ADVERTENCIA — target.py tiene cambios no staged.",
                  file=sys.stderr)
            print("  mutate_target.py hace backup/restore, pero verifique antes.",
                  file=sys.stderr)

    all_ok = True
    for name, path in mutate_tools:
        if args.human:
            # flush=True: el hijo escribe directo a stdout (heredado), asi que
            # sin flush el header del padre se bufferiza y aparece DESPUES de
            # la salida del hijo. Flushear preserva el orden causal.
            print("=== %s ===" % name, flush=True)
        rc = _run_script(path, [], human=args.human)
        if rc != 0:
            all_ok = False
            if args.human:
                print("  FALLO (rc=%d)" % rc, flush=True)
    return 0 if all_ok else 1


