def cmd_verify(args):
    """Ejecuta las 5 herramientas FASE 0 para verificar frontera y contratos.

    Todas declaran: READONLY=yes, WRITES_GPU=no, TOUCHES_INTEGRATED=no.

    En modo --json: captura la salida de cada herramienta, la parsea y
    produce un único objeto JSON resumen en stdout. Nada de la salida
    individual de las herramientas ensucia stdout.

    En modo --human: imprime una línea de status por herramienta.
    """
    tools = [
        ("rxre_boot", os.path.join(FASE0_DIR, "rxre_boot.py")),
        ("rxre_frontier", os.path.join(FASE0_DIR, "rxre_frontier.py")),
        ("rxre_contracts", os.path.join(FASE0_DIR, "rxre_contracts.py")),
        ("rxre_deleg", os.path.join(FASE0_DIR, "rxre_deleg.py")),
        ("rxre_touch", os.path.join(FASE0_DIR, "rxre_touch.py")),
    ]
    env = preparar_entorno_subproceso()
    all_ok = True
    results = {}
    for name, path in tools:
        if not os.path.isfile(path):
            if args.human:
                print("  %s: script no encontrado en %s" % (name, path))
            results[name] = {"status": "error", "motivo": "script no encontrado"}
            all_ok = False
            continue
        cmd_list = [sys.executable, "-B", path, "--json"]
        try:
            p = subprocess.run(cmd_list, capture_output=True, text=True,
                               timeout=120, env=env)
        except subprocess.TimeoutExpired:
            results[name] = {"rc": -1, "status": "timeout"}
            all_ok = False
            if args.human:
                print("  %s TIMEOUT" % name)
            continue
        except FileNotFoundError:
            results[name] = {"rc": -1, "status": "error",
                             "motivo": "python executable no encontrado"}
            all_ok = False
            continue

        # Parsear la salida JSON de la herramienta (puede ser single-line
        # o pretty-printed multi-line). Intentar first_line, luego full output.
        tool_data = {}
        stdout_stripped = p.stdout.strip()
        if stdout_stripped:
            first_line = stdout_stripped.split("\n")[0]
            try:
                tool_data = json.loads(first_line)
            except json.JSONDecodeError:
                try:
                    tool_data = json.loads(stdout_stripped)
                except json.JSONDecodeError:
                    tool_data = {"raw": stdout_stripped[:200]}

        # Extraer estado clave
        estado = (tool_data.get("estado") or
                  tool_data.get("status") or "unknown")
        errores = tool_data.get("errores",
                  tool_data.get("error", []))

        results[name] = {
            "rc": p.returncode,
            "estado": estado,
        }
        if errores:
            results[name]["errores"] = errores
            all_ok = False
        if p.returncode != 0:
            all_ok = False
            if args.human:
                err_summary = p.stderr.strip()[:200] if p.stderr else ""
                print("  %s FALLO (rc=%d)%s" % (name, p.returncode,
                          (" " + err_summary if err_summary else "")))
        elif args.human:
            print("  %s OK (%s)" % (name, estado))

    if args.json:
        print(json.dumps({"status": "ok" if all_ok else "error",
                          "tools": results}, indent=2, ensure_ascii=False))
        return 0 if all_ok else 1
    else:
        return 0 if all_ok else 1


def _discover_findings_dirs():
    """Localiza TODOS los directorios de hallazgos del arbol.

    MEDIDO: el arbol tiene al menos dos (findings/ y
    06-INGENIERIA-INVERSA/findings/). Escanear solo el primero subreporta el
    contador: se midio 1615 en findings/ cuando el maximo real de la union
    era 1623. Por eso esto descubre en vez de hardcodear.
    """
    found = []
    for base, dirs, files in os.walk(RAIZ):
        dirs[:] = [d for d in dirs
                   if d not in (".git", "__pycache__", "node_modules",
                                ".work", "KytyPS5-Source")]
        if os.path.basename(base) == "findings":
            found.append(base)
            dirs[:] = []          # no descender dentro de findings
    return sorted(found)


def _read_reservations():
    """Lee el ledger de reservas y devuelve (max_reservado, n_reservas).

    El ledger mide TRABAJO GASTADO (numeros tomados), que es una magnitud
    distinta del numero de hallazgos escritos. Confundirlas overestimate el
    progreso, asi que se reportan por separado.
    """
    best, n = 0, 0
    for base, dirs, files in os.walk(RAIZ):
        dirs[:] = [d for d in dirs
                   if d not in (".git", "__pycache__", "node_modules",
                                ".work", "KytyPS5-Source")]
        if "RESERVAS.ledger" in files:
            try:
                with open(os.path.join(base, "RESERVAS.ledger"),
                          encoding="utf-8", errors="replace") as fh:
                    for line in fh:
                        tok = line.strip().split("\t")[0]
                        if tok.isdigit():
                            best = max(best, int(tok))
                            n += 1
            except OSError:
                pass
            dirs[:] = []
    return best, n


def cmd_workscan(args):
    """Cuenta hallazgos, repeticiones y authorship sobre TODOS los
    directorios de hallazgos del arbol.

    READONLY: solo list directories, read files, write nothing.

    Distingue dos magnitudes que NO son la misma:
      - hallazgos escritos   : ficheros .md numerados que existen
      - trabajo gastado      : maximo numero reservado en el ledger
    """
    findings_dirs = _discover_findings_dirs()
    if not findings_dirs:
        result = {"status": "blocked",
                  "motivo": "no se encuentra ningun directorio findings/"}
        print(json.dumps(result, indent=2, ensure_ascii=False)
              if args.json else "BLOQUEADO: %s" % result["motivo"])
        return 2

    nums, autores = [], {}
    sin_autor = 0
    ficheros_md = 0
    por_dir = {}

    for fdir in findings_dirs:
        rel = os.path.relpath(fdir, RAIZ)
        d_md = 0
        d_nums = []
        try:
            entries = sorted(os.listdir(fdir))
        except OSError:
            por_dir[rel] = {"ficheros_md": 0, "numerados": 0,
                            "max": 0, "legible": False}
            continue
        for f in entries:
            if not (f.endswith(".md") or f.endswith(".py") or f.endswith(".c")
                    or f.endswith(".h") or f.endswith(".sh") or f.endswith(".rs")):
                continue
            d_md += 1
            ficheros_md += 1
            cab = f.split("-", 1)[0]
            if not cab.isdigit():
                continue
            n = int(cab)
            nums.append(n)
            d_nums.append(n)
            try:
                with open(os.path.join(fdir, f), encoding="utf-8",
                          errors="replace") as fh:
                    txt = fh.read(2000)
            except OSError:
                sin_autor += 1
                continue
            m = re.search(r"^AUTOR=(.+)$", txt, re.M)
            if m:
                who = m.group(1).strip()
                autores[who] = autores.get(who, 0) + 1
            else:
                sin_autor += 1
        por_dir[rel] = {"ficheros_md": d_md, "numerados": len(d_nums),
                        "max": max(d_nums) if d_nums else 0,
                        "legible": True}

    c = Counter(nums)
    max_reservado, n_reservas = _read_reservations()

    result = {
        "status": "ok",
        "dirs_escaneados": len(findings_dirs),
        "ficheros_md": ficheros_md,
        "hallazgos_numerados": len(nums),
        "numeros_distintos": len(set(nums)),
        "repeticiones": len(nums) - len(set(nums)),
        "ficheros_de_mas": sum(v for v in c.values() if v > 1),
        "numero_mas_alto": max(nums) if nums else 0,
        "trabajo_gastado_max": max_reservado,
        "reservas_en_ledger": n_reservas,
        "por_autor": autores,
        "sin_autor": sin_autor,
        "por_dir": por_dir,
        "findings_dirs": [os.path.relpath(d, RAIZ) for d in findings_dirs],
    }

    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print("=== WORKSCAN (%d directorios) ===" % len(findings_dirs))
        for rel in sorted(por_dir):
            d = por_dir[rel]
            if not d.get("legible"):
                print("  %-34s ILEGIBLE" % rel)
                continue
            print("  %-34s md=%-4d numerados=%-4d max=%d"
                  % (rel, d["ficheros_md"], d["numerados"], d["max"]))
        print()
        print("  ficheros .md (union):    %d" % result["ficheros_md"])
        print("  hallazgos numerados:      %d" % result["hallazgos_numerados"])
        print("  numeros distintos:        %d" % result["numeros_distintos"])
        print("  repeticiones:             %d" % result["repeticiones"])
        print("  ficheros de mas:          %d" % result["ficheros_de_mas"])
        print("  MAXIMO ESCRITO:           %d" % result["numero_mas_alto"])
        print("  MAXIMO RESERVADO:         %d  (trabajo gastado, %d reservas)"
              % (result["trabajo_gastado_max"], result["reservas_en_ledger"]))
        if result["por_autor"]:
            print("  por autor:")
            for who, cnt in sorted(result["por_autor"].items()):
                print("    %s: %d" % (who, cnt))
        print("  sin autor:               %d" % result["sin_autor"])
        escrito = result["numero_mas_alto"]
        reservado = result["trabajo_gastado_max"]
        if reservado > 0 and escrito > reservado:
            print()
            print("  NOTA: escrito(%d) > reservado(%d): hay %d numeros"
                  % (escrito, reservado, escrito - reservado))
            print("  ESCRITOS sin pasar por el ledger. El ledger de este")
            print("  arbol no cubre toda la actividad, o los numeros se")
            print("  tomaron sin registrarse. No concluyas de esta cifra.")
        elif reservado > escrito:
            print()
            print("  NOTA: escrito(%d) < reservado(%d): %d numeros"
                  % (escrito, reservado, reservado - escrito))
            print("  reservados SIN fichero detras. Reservar no es escribir.")
    return 0


def cmd_vendors(args):
    """RXRE-ECO-001. El registro canonico de repos externos.

    Muestra URL, commit, licencia, categoria y estado REAL en disco de cada
    repositorio vendorizado en `tools/rxre/github/`.

    Es una operacion de la CLI y no un fichero suelto porque el registro tiene
    que poder consultarse SIN saber que existe un `vendor_manifest.py`: una
    IA que llega al arbol pregunta `./rxre vendors`, no adivina el modulo.
    """
    script = os.path.join(RAIZ, "tools", "rxre", "vendor_manifest.py")
    if not os.path.isfile(script):
        print("rxre vendors: no encuentro %s" % script, file=sys.stderr)
        return 2
    argv_clean, flags = extract_flags(args.argv_after, ["--verify", "--json", "--human"])
    cmd_args = ["--verify"] if flags.get("--verify") else []
    if args.json:
        cmd_args.append("--json")
