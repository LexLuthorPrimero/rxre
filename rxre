# ===========================================================================
# PATH RESOLUTION — desde la ubicación del script, NUNCA del cwd
# ===========================================================================
RAIZ = os.path.dirname(os.path.abspath(__file__))
MACHINE = os.path.join(RAIZ, "tools", "rxre", "api", "machine.py")
RXRE_TOOLS = os.path.join(RAIZ, "tools")
RXRE_PKG = os.path.join(RAIZ, "tools", "rxre")
FASE0_DIR = os.path.join(RAIZ, "RXRE", "tools")

def preparar_entorno_subproceso():
    """Entorno robusto para subprocess: PYTHONPATH + TMPDIR con reserva mínima.

    MEDIDO 2026-10-15: el disco /tmp (tmpfs) quedó a 100%
    (5.9G usados) por una copia de trabajo de 5.2G de otro proceso,
    dejando a cualquier tool sensible al directorio temporal sin espacio
    (Ghidra, JVM hsperfdata, SQLite temp). Siempre hacer caer el TMPDIR a
    /var/tmp (parte del fs raíz, con espacio) antes de invocar subprocess.
    """
    env = dict(os.environ)
    env["PYTHONPATH"] = ":".join(
        p for p in [RXRE_TOOLS, RXRE_PKG, env.get("PYTHONPATH", "")] if p
    )
    tmp = env.get("TMPDIR") or env.get("TMP") or env.get("TEMP") or ""
    if not tmp or not os.path.isdir(tmp):
        tmp = "/var/tmp" if os.path.isdir("/var/tmp") else "/tmp"
    try:
        import shutil as _sh
        free = _sh.disk_usage(tmp).free
    except Exception:
        free = 2 ** 63
    # umbral mínimo: 512 MB
    if free < 512 * 1024 * 1024 and os.path.isdir("/var/tmp"):
        tmp = "/var/tmp"
    env.setdefault("TMPDIR", tmp)
    env.setdefault("TMP", tmp)
    env.setdefault("TEMP", tmp)
    # Java/Ghidra: evita hsperfdata en /tmp lleno, y pone tmpdir seguro
    env.setdefault(
        "JAVA_TOOL_OPTIONS",
        "-Djava.io.tmpdir=%s -XX:-UsePerfData" % tmp,
    )
    return env


# Subcomandos del engine → machine.py ops
ENGINE_OPS = {
    "ops", "capabilities", "backends", "run", "plan", "reflect",
    "explain", "experiment", "lessons", "research", "saturate",
}

# Subcomandos de herramientas integradas
INTEGRATED_TOOLS = {
    "selftest", "inventory", "verify", "workscan", "mutate", "audit", "vendors",
}

ALL_SUBCOMMANDS = ENGINE_OPS | INTEGRATED_TOOLS | {"help"}


