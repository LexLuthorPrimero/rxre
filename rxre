def cmd_run(args):
    argv_clean, flags = extract_flags(args.argv_after, ["--json", "--human"])
    if not argv_clean:
        print("rxre run: falta capability. Usa ./rxre ops para listar.",
              file=sys.stderr)
        return 2
    capability = argv_clean[0]
    kv = parse_kv_args(argv_clean[1:])
    req = {"op": "run", "capability": capability}
    req.update(kv)
    resp, rc = send_to_machine(req)
    return _emit(resp, rc, args)


