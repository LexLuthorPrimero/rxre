def cmd_explain(args):
    """RXRE-AUTO-003. Reconstruye la evidencia (TIERRA+MENTE) Y aplica el gate
    de los ocho principios (RXRE-AUTO-003).

    Antes, `explain` devolvia la cadena de evidencia pero NO el veredicto de
    los ocho principios. Eso forzaba a correr `rxre audit` como un paso
    manual adicional: la misma operacion, otra invocacion, otro script.

    Ahora el gate se incluye automaticamente: `rxre explain <id>` da la
    trazabilidad AND el veredicto de los 8 principios en una sola respuesta.
    La automatizacion es la point: no se pide al usuario que recuerde el
    flag, se incluye por defecto y se puede apagar con --no-gate.
    """
    argv_clean, flags = extract_flags(args.argv_after, ["--json", "--human",
                                                         "--no-gate"])
    result_id = argv_clean[0] if argv_clean else None
    if not result_id:
        print("rxre explain: falta result_id.", file=sys.stderr)
        return 2
    req = {"op": "explain", "result_id": result_id, "audit": not flags.get("--no-gate")}
    resp, rc = send_to_machine(req)
    return _emit(resp, rc, args)


