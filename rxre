# ===========================================================================
# MAIN
# ===========================================================================
def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]

    # --- Pre-check de artefactos ---
    if not verify_artifacts():
        print("rxre: artefactos del motor faltantes. Verifica el workspace.",
              file=sys.stderr)
        return 2

    # --- Detección de modo ---
    mode, subcommand, stdin_data = detect_mode(argv)

    if mode == "jsonl":
        # Passthrough JSONL: enviar datos leídos a machine.py
        cmd = [sys.executable, "-B", MACHINE]
        env = preparar_entorno_subproceso()
        try:
            result = subprocess.run(cmd, input=stdin_data, text=True, env=env)
            return result.returncode
        except Exception as e:
            print("rxre: error en passthrough JSONL: %s" % e, file=sys.stderr)
            return 1

    if mode == "unknown":
        print("rxre: subcomando desconocido: %s" % subcommand, file=sys.stderr)
        print("Usa ./rxre help para ver las opciones.", file=sys.stderr)
        return 2

    if mode == "help" or subcommand == "help" or "-h" in argv or "--help" in argv:
        return print_help()

    if mode == "cli":
        dispatch = {
            "ops": cmd_ops,
            "capabilities": cmd_capabilities,
            "backends": cmd_capabilities,
            "run": cmd_run,
            "plan": cmd_plan,
            "explain": cmd_explain,
            "experiment": cmd_experiment,
            "reflect": cmd_reflect,
            "research": cmd_research,
            "saturate": cmd_saturate,
            "lessons": cmd_lessons,
            "selftest": cmd_selftest,
            "inventory": cmd_inventory,
            "verify": cmd_verify,
            "workscan": cmd_workscan,
            "mutate": cmd_mutate,
            "audit": cmd_audit,
            "vendors": cmd_vendors,
        }

        handler = dispatch.get(subcommand)
        if not handler:
            print("rxre: subcomando desconocido: %s" % subcommand, file=sys.stderr)
            print("Usa ./rxre help para ver las opciones.", file=sys.stderr)
            return 2

        # Parsear flags globales --json y --human
        has_json = "--json" in argv
        has_human = "--human" in argv
        # Extraer argv después del subcommand
        subcommand_idx = next(
            (i for i, a in enumerate(argv) if a == subcommand), -1
        )
        if subcommand_idx >= 0:
            argv_after = argv[subcommand_idx + 1:]
        else:
            argv_after = []

        class Args:
            pass
        args = Args()
        args.json = has_json
        args.human = has_human or (not has_json)
        args.argv_after = argv_after

        return handler(args)

    # No subcommand, no stdin → help
    return print_help()


if __name__ == "__main__":
    sys.exit(main())
