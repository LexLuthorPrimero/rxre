#!/usr/bin/env python3
# RXRE CLI — punto de entrada operativa unificada.
#
# Cualquier IA compatible con ejecución de comandos puede usar RXRE sin
# conocer rutas internas ni scripts individuales. Lee JSONL de stdin,
# escribe JSONL a stdout, y expone subcomandos operativos.
#
#   ./rxre help                         esta ayuda
#   ./rxre ops                          lista las 10 operaciones del engine
#   ./rxre capabilities                 lista las 25 capabilities con estado
#   ./rxre backends                     alias de capabilities
#   ./rxre run binary.inspect --artefacto /bin/ls        ejecuta una capability
#   ./rxre plan binary.decompile --question "..."        planifica sin ejecutar
#   ./rxre explain res_abc123                             reconstruye evidencia
#   ./rxre experiment ...                                 experimento baseline vs modified
#   ./rxre reflect --feedback "..." --outcome failure     registra una reflexión
#   ./rxre research --kind frontier --text "..."          registra hipótesis/frontier
#   ./rxre saturate --target binary.cfg                   evalua saturación de fronteras
#   ./rxre lessons                                         lista lecciones registradas
#
#   ./rxre selftest                                        ejecuta baseline de pruebas
#   ./rxre inventory                                       inventario de herramientas (rxre_boot)
#   ./rxre verify                                          ejecuta las 5 herramientas FASE 0
#   ./rxre workscan                                        cuenta hallazgos, repeticiones, authorship
#   ./rxre mutate                                          mutation testing en tools/
#
# JSONL passthrough (modo compatible):
#   echo '{"op":"ops"}' | ./rxre
#
# Códigos de salida:
#   0  ok o empty   (vacío NO es fallo: mira `status` en el JSON)
#   1  error
#   2  blocked     (la precondición no se cumple; NO se ejecutó)
#
# El motor es tools/rxre/api/machine.py. Las herramientas auxiliares se
# invocan por ruta desde el registro autoritativo (toolreg.py). Nada se
# importa: se ejecuta por subprocess para mantener independencia.

