def verify_artifacts():
    """Confirma que los artefactos productores existen antes de ejecutar."""
    missing = []
    if not os.path.isfile(MACHINE):
        missing.append("tools/rxre/api/machine.py")
    if not os.path.isdir(RXRE_PKG):
        missing.append("tools/rxre/")
    if not os.path.isdir(FASE0_DIR):
        missing.append("RXRE/tools/ (FASE 0)")
    if missing:
        for m in missing:
            print("rxre: artefacto faltante: %s" % m, file=sys.stderr)
        return False
    return True


# ===========================================================================
# MODO DE DETECCION: CLI vs JSONL passthrough
#
# Regla:
#   1. Si el primer argumento posicional (no flag) es un subcomando conocido
#      → CLI mode (el stdin se ignora en este caso).
#   2. Si no es conocido y stdin tiene datos (no TTY) → JSONL passthrough.
#   3. Si no es conocido, stdin está vacío, y hay un arg → error: unknown.
#   4. Si no hay args y stdin está vacío → help.
#
# IMPORTANTE: no se usa select.select para detectar datos en stdin porque
# reporta EOF como "readable", lo que causa falsos positivos de JSONL.
# En su lugar se lee stdin realmente; si hay datos, se envían a machine.py.
#
# Esto preserva consumidores existentes que hacen:
#   echo '{"op":"ops"}' | ./rxre
#   echo '{"op":"run","capability":"..."}' | ./rxre
# ===========================================================================
def detect_mode(argv):
    """Devuelve (mode, subcommand, stdin_data).

    mode ∈ {'cli', 'jsonl', 'help', 'unknown'}
    stdin_data es str (datos leídos) o None.
    """
    positionals = [a for a in argv if not a.startswith("-")]
    first = positionals[0] if positionals else ""

    if first in ALL_SUBCOMMANDS:
        return ("cli", first, None)

    # No es un subcomando conocido → comprobar datos en stdin
    stdin_data = None
    if not sys.stdin.isatty():
        try:
            stdin_data = sys.stdin.read()
        except (OSError, ValueError):
            stdin_data = ""
        if stdin_data and stdin_data.strip():
            return ("jsonl", None, stdin_data)

    # No hay datos en stdin
    if first:
        return ("unknown", first, None)
    return ("help", None, None)


# ===========================================================================
# MOTOR: reenviar JSONL a machine.py
# ===========================================================================
def send_to_machine(request_dict):
    """Construye una petición JSON, se la envía a machine.py y devuelve
    (response_dict, rc). Nunca consume stdin del proceso padre."""
    payload = json.dumps(request_dict, ensure_ascii=False)
    env = preparar_entorno_subproceso()
    try:
        p = subprocess.run(
            [sys.executable, "-B", MACHINE],
            input=payload,
            capture_output=True,
            text=True,
            timeout=300,
            env=env,
        )
    except subprocess.TimeoutExpired:
        return ({"status": "error", "motivo": "timeout",
                 "limitations": ["la operación excedió 300s"]}, 1)
    except FileNotFoundError:
        return ({"status": "error",
                 "motivo": "machine.py no encontrado en %s" % MACHINE}, 1)

    # machine.py devuelve JSONL (una línea por petición). Enviamos una
    # sola petición, tomamos la primera línea no vacía.
    lines = [ln.strip() for ln in p.stdout.strip().split("\n") if ln.strip()]
    if not lines:
        return ({"status": "error",
                 "motivo": "machine.py produjo stdout vacío",
                 "stderr_snippet": p.stderr[-500:]}, p.returncode)
    try:
        resp = json.loads(lines[0])
    except json.JSONDecodeError as e:
        return ({"status": "error",
                 "motivo": "respuesta no JSON: %s" % e,
                 "raw_stdout": lines[0][:200],
                 "stderr_snippet": p.stderr[-500:]}, 1)

    if p.stderr:
        sys.stderr.write(p.stderr)

    return resp, p.returncode


def fmt_human(resp):
    """Formatea una respuesta del engine como texto legible para humanos.

    Devuelve (texto, exit_code). El exit_code refleja el `status` de la
    respuesta, no el rc de machine.py.
    """
    status = resp.get("status", "unknown")

    if status == "blocked":
        lines = ["BLOQUEADO: %s" % (resp.get("motivo") or "precondicion no cumplida")]
        for lim in resp.get("limitations", []):
            lines.append("  - %s" % lim)
        return "\n".join(lines), 2

    if status == "error":
        lines = ["ERROR: %s" % (resp.get("motivo") or "sin detalle")]
        for lim in resp.get("limitations", []):
            lines.append("  - %s" % lim)
        return "\n".join(lines), 1

    if status == "unsupported":
        lines = ["NO SOPORTADO: %s" % (resp.get("motivo") or "backend no disponible")]
        for lim in resp.get("limitations", []):
            lines.append("  - %s" % lim)
        return "\n".join(lines), 0

    if status == "invalid_input":
        lines = ["ENTRADA INVÁLIDA: %s" % (resp.get("motivo") or "parametro incorrecto")]
        if resp.get("capability"):
            lines.append("  capability: %s" % resp["capability"])
        for lim in resp.get("limitations", []):
            lines.append("  - %s" % lim)
        return "\n".join(lines), 1

    if status in ("ok", "empty"):
        results = resp.get("results", [])
        cap = resp.get("capability", resp.get("operation", ""))
        lines = []
        if cap:
            lines.append("=== %s === [%s]" % (cap, status))

        if not results and not resp.get("capacities"):
            if resp.get("limitations"):
                lines.append("SIN RESULTADOS (%s)" % status)
                for lim in resp.get("limitations", []):
                    lines.append("  - %s" % lim)
            else:
                lines.append("OK (%s)" % status)
            return "\n".join(lines), 0

        # Capacidades como dict (backends/capabilities op)
        capacities = resp.get("capacities", resp.get("capacidades", {}))
        if capacities and isinstance(capacities, dict) and not results:
            lines.append("=== %d capabilities ===" % len(capacities))
            for name in sorted(capacities.keys()):
                detail = capacities[name]
                if isinstance(detail, dict):
                    estado = detail.get("estado_agregado", detail.get("estado", "?"))
                    backends = detail.get("backends", [])
                    lines.append("  %-40s %-12s backends: %s" %
                                 (name, estado, ", ".join(backends)))
                else:
                    lines.append("  %s" % name)
            return "\n".join(lines), 0

        # Results como lista de dicts
        if results:
            lines.append("=== %d resultado(s) ===" % len(results))
            for i, r in enumerate(results):
                lines.append("")
                label = r.get("type", r.get("kind", r.get("title",
                          r.get("result_id", "resultado"))))
                sub = r.get("status", r.get("verdict", ""))
                lines.append("%d. %s %s" % (i + 1, label,
                          ("[%s]" % sub if sub else "")))

                # Campos conocidos en orden de importancia
                known_fields = [
                    "value", "value_hex", "kind", "title", "source",
                    "artifact", "tool", "scope", "unit", "offset", "symbol",
                    "description", "verdict", "backend_id", "backend_rc",
                    "operation", "operation_id", "timestamp", "result_id",
                    "input_hash", "artifact_hash", "estado",
                    # Engine op descriptors (from ops/backends)
                    "op", "descripcion", "ejemplo", "campos",
                    # Backend info
                    "backend", "backend_identity", "ejecucion", "provenance",
                    "precheck", "trace_id", "operation_id", "persistido",
                    "regla", "motivo", "backend_status", "limitaciones",
                ]
                for k in known_fields:
                    if k in r and r[k] is not None:
                        v = r[k]
                        if isinstance(v, dict):
                            lines.append("   %s:" % k)
                            for kk, vv in _flatten_dict(v):
                                lines.append("     %s: %s" % (kk, vv))
                        elif isinstance(v, list):
                            lines.append("   %s: %s" % (k, json.dumps(v, ensure_ascii=False)))
                        else:
                            lines.append("   %s: %s" % (k, v))

                # Limitations dentro del resultado
                if r.get("limitations"):
                    lines.append("   limitaciones:")
                    for lim in r["limitations"][:5]:
                        lines.append("     - %s" % lim)

                # Next actions dentro del resultado
                if r.get("next_actions"):
                    lines.append("   siguiente:")
                    for na in r["next_actions"][:5]:
                        lines.append("     -> %s: %s" % (na.get("op", "?"),
                                                         na.get("descripcion", "")))

                # Fallback: cualquier campo no mostrado
                shown = set(known_fields) | {"limitations", "next_actions",
                                             "result_id", "status", "type"}
                extra = {k: v for k, v in r.items() if k not in shown and v}
                if extra:
                    lines.append("   extra:")
                    for k, v in extra.items():
                        lines.append("     %s: %s" % (k, json.dumps(v, ensure_ascii=False)[:120]))

        return "\n".join(lines), 0

    # Status desconocido → dump JSON
    return json.dumps(resp, indent=2, ensure_ascii=False), 0


def _flatten_dict(d, prefix=""):
    """Achata un dict anidado para salida legible."""
    out = []
    for k, v in d.items():
        key = "%s.%s" % (prefix, k) if prefix else k
        if isinstance(v, dict):
            out.extend(_flatten_dict(v, key))
        elif isinstance(v, list):
            out.append((key, json.dumps(v, ensure_ascii=False)))
        else:
            out.append((key, v))
    return out


# ===========================================================================
# PARSEO DE ARGUMENTOS
# ===========================================================================
def parse_kv_args(rest):
    """Parsea pares --key value restantes en un dict.

    Los flags booleanos (--flag sin valor siguiente) se convierten en True.
    Intenta inferir tipos: int, float, bool, str.
    """
    params = {}
    i = 0
    while i < len(rest):
        arg = rest[i]
        if arg.startswith("--"):
            key = arg[2:].replace("-", "_")
            if i + 1 < len(rest) and not rest[i + 1].startswith("--"):
                val = rest[i + 1]
                # Inferir tipo
                if val.lower() in ("true", "false"):
                    val = val.lower() == "true"
                else:
                    try:
                        if "." in val:
                            val = float(val)
                        else:
                            val = int(val)
                    except ValueError:
                        pass
                params[key] = val
                i += 2
            else:
                params[key] = True
                i += 1
        else:
            # Argumento posicional no flag → lo ignorimos (la capability ya se parseo)
            i += 1
    return params


def extract_flags(argv, flags):
    """Extrae flags booleanos de una lista de argv, devuelve (limpio, flags_dict)."""
    result = {}
    cleaned = []
    for f in flags:
        if f in argv:
            result[f] = True
            argv = [a for a in argv if a != f]
        else:
            result[f] = False
        # Also handle --flag=value
    return argv, result


