{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "bash": {
      "*": "allow",

      "sudo": "allow",
      "sudo *": "allow",
      "su": "ask",
      "su *": "ask",
      "doas": "deny",
      "pkexec": "deny",

      "systemctl": "deny",
      "systemctl *": "deny",
      "service *": "deny",
      "journalctl --vacuum*": "deny",

      "shutdown": "deny",
      "shutdown *": "deny",
      "reboot": "deny",
      "poweroff": "deny",
      "halt": "deny",
      "init 0": "deny",
      "init 6": "deny",

      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf $HOME": "deny",
      "rm -rf $HOME/*": "deny",
      "mkfs*": "deny",
      "dd if=*of=/dev/*": "deny",
      "> /dev/sd*": "deny",
      "shred *": "deny",
      "chown -R *": "ask",
      "chmod -R 777 /*": "deny",

      "git commit*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git checkout -- *": "ask",
      "git restore *": "ask",
      "git clean *": "ask",
      "git rebase*": "ask",
      "git filter-branch*": "deny",

      "c1 *": "deny",
      "run_c1*": "deny",
      "vkmark *": "deny",
      "glxgears*": "deny",
      "glmark2*": "deny",
      "unigine *": "deny",
      "gravitymark*": "deny",
      "superposition*": "deny",
      "nvidia-smi*": "deny",
      "nvtop*": "deny",
      "amdgpu_top*": "deny",

      "echo * > /sys/*": "deny",
      "echo * >/sys/*": "deny",
      "tee /sys/*": "deny",
      "tee -a /sys/*": "deny",
      "cat * > /sys/*": "deny",
      "printf * > /sys/*": "deny",
      "cp * /sys/*": "deny",
      "mv * /sys/*": "deny",
      "ln -sf * /sys/*": "deny",
      "modprobe*": "deny",
      "insmod *": "deny",
      "rmmod *": "deny",
      "rm /sys/*": "deny",
      "sed -i* /sys/*": "deny",

      "curl * | sh": "allow",
      "curl * | bash": "allow",
      "wget * | sh": "deny",
      "wget * | bash": "deny",
      "pip install*": "allow",
      "dnf install*": "allow",
      "dnf remove*": "ask",
      "apt install*": "allow",
      "apt remove*": "ask",
      "npm install -g*": "allow",

      "history -c*": "deny",
      "> ~/.bash_history": "deny"
    },

    "edit": {
      "*": "allow",
      "/etc/*": "deny",
      "/boot/*": "deny",
      "/sys/*": "deny",
      "/proc/sys/*": "deny",
      "~/.config/opencode/*": "ask",
      "**/*.env": "deny",
      "**/*.env.*": "deny"
    },

    "read": {
      "*": "allow",
      "**/*.env": "allow",
      "**/*.env.*": "allow"
    },

    "webfetch": "allow",
    "websearch": "allow",

    "task": {
      "*": "allow",
      "adversarial-reviewer": "allow",
      "document-auditor": "allow",
      "source-critic": "allow"
    },

    "external_directory": "allow",
    "doom_loop": "allow"
  },

  "agent": {
    "adversarial-reviewer": {
      "mode": "subagent",
      "description": "Independent refutation of a result, document or hypothesis. Read-only. Use when a conclusion needs an adversary that did not produce it.",
      "temperature": 0.1,
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git show*": "allow",
          "git diff*": "allow",
          "git status*": "allow",
          "sha256sum*": "allow",
          "grep*": "allow",
          "find*": "allow",
          "wc*": "allow",
          "ls*": "allow",
          "cat*": "allow",
          "head*": "allow",
          "tail*": "allow",
          "sort*": "allow",
          "uniq*": "allow",
          "cut*": "allow",
          "awk*": "allow",
          "sed*": "allow",
          "diff*": "allow",
          "python3 -c*": "allow",
          "python3 -m json.tool*": "allow"
        },
        "task": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "external_directory": "allow",
        "question": "allow"
      }
    },

    "document-auditor": {
      "mode": "subagent",
      "description": "Verifies traceability of a document set: hashes, table integrity, cross-references, declared counts versus actual rows, and state-token consistency. Read-only.",
      "temperature": 0.0,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "sha256sum*": "allow",
          "grep*": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git ls-files*": "allow",
          "find*": "allow",
          "wc*": "allow",
          "ls*": "allow",
          "awk*": "allow",
          "sed*": "allow",
          "cut*": "allow",
          "sort*": "allow",
          "uniq*": "allow",
          "diff*": "allow",
          "cat*": "allow",
          "head*": "allow",
          "python3 -c*": "allow"
        },
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "deny"
      }
    },

    "source-critic": {
      "mode": "subagent",
      "description": "Rates a source on authority, date, version, scope and what it does NOT prove, and asks whether a primary source was available. Read-only.",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "sha256sum*": "allow",
          "ls*": "allow",
          "head*": "allow",
          "tail*": "allow",
          "file *": "allow",
          "wc*": "allow",
          "grep*": "allow"
        },
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "deny"
      }
    }
  }
}
