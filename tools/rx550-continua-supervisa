#!/usr/bin/env bash
# rx550-continua-supervisa — mantiene vivo al vigilante.
#
# POR QUE EXISTE: el vigilante (rx550-continua) es un proceso normal. Si muere por
# cualquier motivo —error, OOM, un fallo de curl no contemplado— nadie lo revive, y
# todas las sesiones se quedan paradas sin que nada lo indique. Eso es peor que no
# arrancarlo: uno cree que esta trabajando.
#
# MEDIDO: no es teorico. Durante el setup el vigilante se mato dos veces por un pkill
# mal hecho y en ambas quedo caido sin avisar.
#
# Este supervisor solo hace una cosa: si el vigilante no esta vivo, lo arranca.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VIGILANTE="$DIR/rx550-continua"
LOG="${RX550_CONTINUA_SUP_LOG:-/tmp/rx550-continua-sup.log}"
PAUSA="$DIR/continua.pausado"

[ -x "$VIGILANTE" ] || { echo "FALTA: $VIGILANTE no existe o no es ejecutable" >&2; exit 1; }

log() { printf '%s  [sup] %s\n' "$(date -Is)" "$*" >>"$LOG"; }

log "SUPERVISOR arrancado; vigilando $VIGILANTE"

while true; do
  # pgrep -f sobre el nombre propio del vigilante. Con setsid el supervisor queda
  # desligado de la terminal, asi que sobrevive a que se cierre la sesion.
  if ! pgrep -f "$VIGILANTE" >/dev/null 2>&1; then
    if [ -e "$PAUSA" ]; then
      # Pausa intentional: no relanzar. Es lo que el usuario quiso al tocar el flag.
      log "PAUSA presente; no relanzo"
    else
      log "vigilante MUERTO; relanzando"
      setsid "$VIGILANTE" >>"${RX550_CONTINUA_LOG:-/tmp/rx550-continua.log}" 2>&1 < /dev/null &
      sleep 5
      pgrep -f "$VIGILANTE" >/dev/null 2>&1 \
        && log "vigilante relanzado OK" \
        || log "ERROR: el vigilante no arranco"
    fi
  fi
  sleep 20
done